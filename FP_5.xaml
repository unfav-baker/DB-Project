<Window  
    x:Class="Dashboard.FP_5"  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
    xmlns:CC="clr-namespace:Dashboard.CustomControls"  
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
    xmlns:local="clr-namespace:Dashboard"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
    Title="Forgot Password"  
    Height="450" Width="617"  
    Background="Transparent"  
    WindowStyle="None"  
    AllowsTransparency="True"  
    mc:Ignorable="d">

    <!-- Rounded Window -->
    <Border CornerRadius="30" Background="#FFE4E9EF" BorderBrush="#FFE4E9EF" BorderThickness="1">

        <!-- Grid Wrapped in Rounded Border -->
        <Border CornerRadius="20" Margin="65,10,10,10">
            <Grid Margin="-56,0,0,0" Background="#FFE4E9EF">

                <Grid.RowDefinitions>
                    <RowDefinition Height="0*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="49*"/>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="208*"/>
                    <ColumnDefinition Width="339*"/>
                    <ColumnDefinition Width="0*"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock HorizontalAlignment="Left" Margin="10,33,0,0" TextWrapping="Wrap" 
                         Text="Forgot Password" VerticalAlignment="Top" Foreground="#FF0080C3" 
                         FontWeight="Bold" FontSize="32" Width="335" Grid.Column="2" 
                         Grid.RowSpan="2" Grid.ColumnSpan="2"/>

                <!-- Subtitle -->
                <TextBlock HorizontalAlignment="Left" Margin="49,81,0,0" TextWrapping="Wrap" 
                         Text="Reset Your Password" VerticalAlignment="Top" 
                         FontWeight="Bold" FontSize="16" Foreground="Black" Height="19" 
                         Width="200" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2"/>

                <!-- Description -->
                <TextBlock HorizontalAlignment="Left" Margin="26,107,0,0" TextWrapping="Wrap" 
                         Text="Enter your email to receive reset instructions" VerticalAlignment="Top" 
                         Width="220" Background="{x:Null}" FontSize="10" Grid.Column="2" 
                         Grid.RowSpan="2" Grid.ColumnSpan="2"/>

                <!-- Return Link -->
                <TextBlock  
                    Margin="10,10,187,399"  
                    FontSize="14"  
                    FontWeight="Bold" Grid.ColumnSpan="3" Grid.RowSpan="2">  
                    <Hyperlink Click="ReturnToPreviousPage">  
                        ← Return  
                    </Hyperlink>
                </TextBlock>

                <!-- Email Input -->
                <CC:Dashboard  
                    Margin="0,139,0,254"  
                    BorderThickness="1"  
                    CaretBrush="Black"  
                    VerticalContentAlignment="Center"  
                    CornerRadius="18"  
                    FontFamily="Segoe UI Symbol"  
                    FontSize="16"  
                    PlaceHolder="Email Address" BorderBrush="Black" Foreground="Black" 
                    Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" 
                    Width="246" Height="35" Grid.Column="2" />

                <!-- Send Reset Link Button -->
                <Button Content="Send Reset Link"  
                      
                    Background="#FF0080C3"  
                    Foreground="White"  
                    FontSize="14"  
                    FontWeight="Bold"  
                    Width="160" Height="35"  
                    BorderThickness="0"  
                    Cursor="Hand"  
                    HorizontalAlignment="Left"  
                    VerticalAlignment="Top"  
                    Margin="43,200,0,0"  
                    RenderTransformOrigin="0.656,-1.011"  
                    Grid.RowSpan="2" Grid.Column="2">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border"  
                                Background="{TemplateBinding Background}"  
                                CornerRadius="15"  
                                Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF005B9F"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF003F75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Additional Information -->
                <TextBlock HorizontalAlignment="Left" Margin="16,275,0,0" TextWrapping="Wrap" 
                         Text="Remember your password?" VerticalAlignment="Top" Width="180" 
                         FontSize="14" Background="{x:Null}" Grid.Column="2" Grid.RowSpan="2"/>

                <TextBlock HorizontalAlignment="Left" Margin="190,276,0,0"  
                    VerticalAlignment="Top" FontSize="14" FontWeight="Bold"  
                    Foreground="#FF0080C3" TextWrapping="Wrap"  
                    Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2">  
                    <Hyperlink Click="SignIn_Click" TextDecorations="Underline">  
                        Sign In  
                    </Hyperlink>
                </TextBlock>

                <!-- Help Text -->
                <TextBlock HorizontalAlignment="Left" Margin="16,320,0,0" TextWrapping="Wrap" 
                         Text="Check your spam folder if you don't receive the email" 
                         VerticalAlignment="Top" Width="246" FontSize="10" FontStyle="Italic"
                         Foreground="Gray" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2"/>

                <!-- Success/Error Message Placeholder -->
                <TextBlock x:Name="MessageTextBlock" HorizontalAlignment="Left" Margin="16,175,0,0" 
                         TextWrapping="Wrap" VerticalAlignment="Top" Width="246" 
                         FontSize="12" FontWeight="Bold" Grid.Column="2" Grid.RowSpan="2" 
                         Grid.ColumnSpan="2" Visibility="Collapsed"/>

                <!-- Decorative Image -->
                <Image Grid.Column="3" HorizontalAlignment="Left" Height="297" 
                      Margin="54,92,0,0" Grid.RowSpan="2" VerticalAlignment="Top" 
                      Width="265" Stretch="Fill" 
                      Source="/Images/Forget_Password.png"/>

            </Grid>
        </Border>

    </Border>
</Window>