<Page x:Class="Employee.ViewReport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Employee"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="View Report Details" Background="#FFF0F2F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Report Details" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#FF065668"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ReportDetailsPanel">
                <TextBlock Margin="5">
                    <Run FontWeight="Bold">Report ID:</Run>
                    <Run Text="{Binding ReportId, FallbackValue='N/A'}"/>
                </TextBlock>
                <TextBlock Margin="5">
                    <Run FontWeight="Bold">Report Type:</Run>
                    <Run Text="{Binding ReportType, FallbackValue='N/A'}"/>
                </TextBlock>
                <TextBlock Margin="5">
                    <Run FontWeight="Bold">Date Generated:</Run>
                    <Run Text="{Binding DateGenerated, StringFormat='dd/MM/yyyy', FallbackValue='N/A'}"/>
                </TextBlock>
                <TextBlock Margin="5">
                    <Run FontWeight="Bold">Status:</Run>
                    <Run Text="{Binding Status, FallbackValue='N/A'}"/>
                </TextBlock>
                <TextBlock Margin="5">
                    <Run FontWeight="Bold">Employee:</Run>
                    <Run Text="{Binding EmployeeName, FallbackValue='N/A'}"/>
                    <Run Text=" (ID: "/>
                    <Run Text="{Binding EmployeeId, FallbackValue='N/A'}"/>
                    <Run Text=")"/>
                </TextBlock>
                <TextBlock Margin="5">
                    <Run FontWeight="Bold">Created At:</Run>
                    <Run Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm', FallbackValue='N/A'}"/>
                </TextBlock>
                <TextBlock Margin="5">
                    <Run FontWeight="Bold">Updated At:</Run>
                    <Run Text="{Binding UpdatedAt, StringFormat='dd/MM/yyyy HH:mm', FallbackValue='N/A'}"/>
                </TextBlock>

                <Border BorderBrush="LightGray" BorderThickness="0,1,0,0" Margin="0,15,0,15"/>
                <TextBlock Text="Full Report Content/Details (Placeholder):" FontWeight="Bold" Margin="5"/>
                <TextBlock Text="{Binding ReportDetailsPlaceholder, FallbackValue='More detailed content for the report would go here...'}" Margin="5" TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Back to Reports List" Click="BackButton_Click" 
                HorizontalAlignment="Left" Margin="0,15,0,0" Padding="10,5"/>
    </Grid>
</Page>
