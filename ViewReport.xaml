<Page x:Class="Adminn.ViewReport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="ViewReport">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="61"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF065668">
            <TextBlock Text="📊 View Report"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="24,0,0,0"
                       Foreground="White"
                       FontSize="22" FontWeight="Bold"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
            <StackPanel x:Name="ReportContentPanel">
                <Button Content="← Back to Reports"
                        HorizontalAlignment="Left"
                        Width="auto" Padding="10,5"
                        Height="30"
                        Background="#6C757D" BorderBrush="#6C757D"
                        Foreground="White"
                        Click="BackToReports_Click"
                        Margin="0,0,0,20"/>

                <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Report Summary" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Report Type:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="ReportTypeText" Text="[Report Type]" Margin="0,0,0,10"/>
                            <TextBlock Text="Generated On:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="GeneratedDateText" Text="[Date]" Margin="0,0,0,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="StatusText" Text="[Status]" Foreground="Green" Margin="0,0,0,10"/>
                            <TextBlock Text="Last Updated:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="UpdatedDateText" Text="[Date]" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="1" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Performance Metrics" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <DataGrid x:Name="ReportDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding ReportMetrics}"
                                  CanUserResizeColumns="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  MinHeight="150" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="2*" MinWidth="150"/>
                                <DataGridTextColumn Header="Value"  Binding="{Binding Value}"  Width="*"  MinWidth="100"/>
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"  MinWidth="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.5*" MinWidth="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Print Report" Width="auto" Padding="10,5" Height="35" Background="#FF28A745" BorderBrush="#FF28A745" Foreground="White" Margin="0,0,10,0" Click="PrintReport_Click"/>
                    <Button Content="Export Report" ToolTip="Export as XPS Document" Width="auto" Padding="10,5" Height="35" Background="#FF17A2B8" BorderBrush="#FF17A2B8" Foreground="White" Click="ExportReport_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>