<Page x:Class="Adminn.Customer" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Adminn" 
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      d:DesignWidth="800" 
      Title="Customer">
    <Grid>
        <Grid>
            <!-- DataGrid -->
            <DataGrid x:Name="CustomerDataGrid" 
                     Margin="0,61,0,45" 
                     AutoGenerateColumns="False" 
                     CanUserAddRows="False" 
                     HeadersVisibility="Column" 
                     IsReadOnly="False" 
                     SelectionMode="Single" 
                     BorderBrush="Black" 
                     ItemsSource="{Binding Customers}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="50" Header="" Binding="{Binding IsSelected}" />
                    <DataGridTextColumn Width="100" Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" />
                    <DataGridTextColumn Width="120" Header="Phyto Number" Binding="{Binding PhytoNumber}" />
                    <DataGridTextColumn Width="150" Header="Party Name" Binding="{Binding PartyName}" />
                    <DataGridTextColumn Width="120" Header="Export Through" Binding="{Binding ExportThrough}" />
                    <DataGridTextColumn Width="120" Header="Plant" Binding="{Binding Plant}" />
                    <DataGridTextColumn Width="120" Header="Importer" Binding="{Binding Importer}" />
                    <DataGridTextColumn Width="80" Header="Carton" Binding="{Binding Carton}" />
                    <DataGridTextColumn Width="80" Header="Weight" Binding="{Binding Weight}" />
                    <DataGridTextColumn Width="80" Header="Rate" Binding="{Binding Rate, StringFormat=C}" />
                    <DataGridTextColumn Width="100" Header="Amount" Binding="{Binding Amount, StringFormat=C}" />
                    <DataGridTextColumn Width="100" Header="Received" Binding="{Binding Received, StringFormat=C}" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.ColumnSpan="2" Height="45" VerticalAlignment="Bottom" Background="White">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Add New Customer" 
                           RenderTransformOrigin="0.718,-0.081" 
                           Background="#FF065668" 
                           BorderBrush="#FF065668" 
                           Width="118" 
                           Foreground="White" 
                           Height="27" 
                           Click="AddCustomer_Click"
                           Margin="0,0,10,0"/>
                    <Button Content="👁" 
                           Background="Black" 
                           BorderBrush="Black" 
                           Width="30" 
                           Foreground="White" 
                           Height="27" 
                           Margin="0,0,5,0" 
                           FontSize="14" 
                           Click="ViewCustomer_Click"/>
                    <Button Content="✏" 
                           Background="#FF4A90E2" 
                           BorderBrush="#FF4A90E2" 
                           Width="30" 
                           Foreground="White" 
                           Height="27" 
                           Margin="0,0,5,0" 
                           FontSize="14" 
                           Click="EditCustomer_Click"/>
                    <Button Content="🗑" 
                           Background="#FFDC3545" 
                           BorderBrush="#FFDC3545" 
                           Width="30" 
                           Foreground="White" 
                           Height="27" 
                           Margin="0,0,0,0" 
                           FontSize="14" 
                           Click="DeleteCustomer_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Background="#FF065668" Height="61" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" 
                  Margin="24,13,0,0" 
                  TextWrapping="Wrap" 
                  Text="👥 Customer" 
                  VerticalAlignment="Top" 
                  Width="156" 
                  Foreground="White" 
                  Background="#FF065668" 
                  FontSize="22" 
                  FontWeight="Bold"/>
    </Grid>
</Page>