<Page x:Class="Adminn.Customer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="1000" Title="Customers">
    <Page.Resources>
        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Page.Resources>
    <Grid Background="#FFF0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="61"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF065668">
            <TextBlock Text="👥 Customers"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"
                       Foreground="White"
                       FontSize="22" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <DataGrid x:Name="CustomerDataGrid"
                      ItemsSource="{Binding Customers}" 
                      Margin="0,0,0,0" AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True" SelectionMode="Single" BorderBrush="#CCCCCC" BorderThickness="1"
                      HorizontalGridLinesBrush="#FFE0E0E0" VerticalGridLinesBrush="#FFE0E0E0"
                      RowBackground="White" AlternatingRowBackground="#FFF9F9F9"
                      HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="40" Header="" Binding="{Binding IsSelected}" CanUserResize="False"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding CustomerId}" MinWidth="60" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Name (Party)" Binding="{Binding Name}" MinWidth="150" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" MinWidth="110" Width="1.2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" MinWidth="150" Width="1.5*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" MinWidth="180" Width="2.5*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Customer Type" Binding="{Binding CustomerType}" MinWidth="100" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Business Name" Binding="{Binding BusinessName}" MinWidth="130" Width="1.5*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" MinWidth="80" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Registered On" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy'}" MinWidth="100" Width="Auto" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Add New Customer"
                            Background="#FF065668" BorderBrush="#FF065668"
                            Width="auto" Padding="10,7" Foreground="White" Height="30"
                            Click="AddCustomer_Click" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <Button Content="👁" ToolTip="View Selected Customer"
                            Background="#6C757D" BorderBrush="#6C757D"
                            Width="35" Foreground="White" Height="30" Margin="0,0,5,0" FontSize="14"
                            Click="ViewCustomer_Click"/>
                    <Button Content="🗑" ToolTip="Delete Selected Customer"
                            Background="#FFDC3545" BorderBrush="#FFDC3545"
                            Width="35" Foreground="White" Height="30" FontSize="14"
                            Click="DeleteCustomer_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
