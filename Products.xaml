<Page x:Class="Adminn.Products"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Products">
    <Grid>
        <Grid>
            <DataGrid x:Name="ProductsDataGrid"
                     Margin="0,61,0,45"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     HeadersVisibility="Column"
                     IsReadOnly="False"
                     SelectionMode="Single"
                     BorderBrush="Black"
                     ItemsSource="{Binding products}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="50" Header="" Binding="{Binding IsSelected}" />
                    <DataGridTextColumn Width="100" Header="Product ID" Binding="{Binding ProductId}" />
                    <DataGridTextColumn Width="120" Header="Supplier ID" Binding="{Binding SupplierId}" />
                    <DataGridTextColumn Width="150" Header="Category" Binding="{Binding Category}" />
                    <DataGridTextColumn Width="120" Header="Quantity" Binding="{Binding Quantity}" />
                    <DataGridTextColumn Width="120" Header="Price" Binding="{Binding Price, StringFormat=C}" />
                    <DataGridTextColumn Width="120" Header="Batch No" Binding="{Binding BatchNo}" />
                    <DataGridTextColumn Width="80" Header="Status" Binding="{Binding Status}" />
                    <DataGridTextColumn Width="100" Header="Created At" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" />
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.ColumnSpan="2" Height="45" VerticalAlignment="Bottom" Background="White">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Add New Product"
                           RenderTransformOrigin="0.718,-0.081"
                           Background="#FF065668"
                           BorderBrush="#FF065668"
                           Width="118"
                           Foreground="White"
                           Height="27"
                           Click="AddProduct_Click"
                           Margin="0,0,10,0"/>
                    <Button Content="👁"
                           Background="Black"
                           BorderBrush="Black"
                           Width="30"
                           Foreground="White"
                           Height="27"
                           Margin="0,0,5,0"
                           FontSize="14"
                           Click="ViewProduct_Click"/>
                    <Button Content="✏"
                           Background="#FF4A90E2"
                           BorderBrush="#FF4A90E2"
                           Width="30"
                           Foreground="White"
                           Height="27"
                           Margin="0,0,5,0"
                           FontSize="14"
                           Click="EditProduct_Click"/>
                    <Button Content="🗑"
                           Background="#FFDC3545"
                           BorderBrush="#FFDC3545"
                           Width="30"
                           Foreground="White"
                           Height="27"
                           Margin="0,0,10,0"
                           FontSize="14"
                           Click="DeleteProduct_Click"/>
                    <Button Content="📊 Report"
                           Background="#FF28A745"
                           BorderBrush="#FF28A745"
                           Width="80"
                           Foreground="White"
                           Height="27"
                           Margin="0,0,0,0"
                           FontSize="12"
                           Click="CreateReport_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Background="#FF065668" Height="61" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left"
                  Margin="24,13,0,0"
                  TextWrapping="Wrap"
                  Text="📦 Products"
                  VerticalAlignment="Top"
                  Width="161"
                  Foreground="White"
                  Background="#FF065668"
                  FontSize="22"
                  FontWeight="Bold"/>
    </Grid>
</Page>