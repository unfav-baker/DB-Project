<Page x:Class="Supplier.Products"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Supplier"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Products">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="61"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF065668">
            <TextBlock Text="📦 Products"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="24,0,0,0"
                       Foreground="White"
                       FontSize="22" FontWeight="Bold"/>
        </Grid>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="ProductsDataGrid"
                      Grid.Row="0"
                      Margin="0,0,0,10" AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="False" SelectionMode="Single" BorderBrush="#CCCCCC"
                      BorderThickness="1"
                      ItemsSource="{Binding ProductList}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                   
                    <DataGridTextColumn Header="Product ID"   Binding="{Binding ProductId}"     Width="100" MinWidth="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Supplier ID"  Binding="{Binding SupplierId}"    Width="100" MinWidth="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Category"     Binding="{Binding Category}"      Width="1.5*" MinWidth="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Quantity"     Binding="{Binding Quantity}"      Width="80"  MinWidth="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Price"        Binding="{Binding Price, StringFormat=C}" Width="100" MinWidth="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Batch No"     Binding="{Binding BatchNo}"       Width="1*"  MinWidth="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status"       Binding="{Binding Status}"        Width="90" MinWidth="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Created At"   Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="120" MinWidth="100" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1"
                    Height="45"
                    Background="#F5F5F5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Content="📊 Report" ToolTip="Create Report for Product(s)"
                                Background="#FF28A745"
                                BorderBrush="#FF28A745"
                                Width="auto" Padding="10,5"
                                Foreground="White"
                                Height="30"
                                Margin="0,0,0,0"
                                FontSize="12"
                                Click="CreateReport_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
