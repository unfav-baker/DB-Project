<Page x:Class="Adminn.AddEmployee"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Add New Employee">

    <Grid Background="#FFF5F5F5">
        <!-- Header -->
        <Grid Background="#FF065668" Height="61" VerticalAlignment="Top">
            <TextBlock HorizontalAlignment="Left" Margin="24,13,0,0" TextWrapping="Wrap" 
                      Text="➕ Add New Employee" VerticalAlignment="Top" Width="250" 
                      Foreground="White" FontSize="22" FontWeight="Bold"/>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Margin="0,61,0,0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,30,40,30">
                <Border Background="White" CornerRadius="10" Padding="40">
                    <Border.Effect>
                        <DropShadowEffect Color="LightGray" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.3"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Form Title -->
                        <TextBlock Text="Employee Information" FontSize="24" FontWeight="Bold" 
                                  Foreground="#FF065668" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                        <!-- Form Fields -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Name -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="Full Name *" FontWeight="SemiBold" Foreground="#FF065668" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtName" Height="35" Padding="10,0" FontSize="14"
                                        BorderBrush="#FF065668" BorderThickness="1" Background="White"/>
                            </StackPanel>

                            <!-- Role -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="Role/Position *" FontWeight="SemiBold" Foreground="#FF065668" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbRole" Height="35" Padding="10,0" FontSize="14"
                                         BorderBrush="#FF065668" BorderThickness="1" Background="White">
                                    <ComboBoxItem Content="Manager"/>
                                    <ComboBoxItem Content="Developer"/>
                                    <ComboBoxItem Content="Designer"/>
                                    <ComboBoxItem Content="Analyst"/>
                                    <ComboBoxItem Content="HR"/>
                                    <ComboBoxItem Content="Sales"/>
                                    <ComboBoxItem Content="Support"/>
                                    <ComboBoxItem Content="Admin"/>
                                    <ComboBoxItem Content="Software Engineer"/>
                                    <ComboBoxItem Content="Project Manager"/>
                                    <ComboBoxItem Content="UI/UX Designer"/>
                                    <ComboBoxItem Content="Business Analyst"/>
                                    <ComboBoxItem Content="DevOps Engineer"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Phone Number -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="Phone Number *" FontWeight="SemiBold" Foreground="#FF065668" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtPhoneNumber" Height="35" Padding="10,0" FontSize="14"
                                        BorderBrush="#FF065668" BorderThickness="1" Background="White"
                                        MaxLength="15" Text=""/>
                            </StackPanel>

                            <!-- Salary -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="Salary *" FontWeight="SemiBold" Foreground="#FF065668" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtSalary" Height="35" Padding="10,0" FontSize="14"
                                        BorderBrush="#FF065668" BorderThickness="1" Background="White"/>
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,30">
                                <TextBlock Text="Status *" FontWeight="SemiBold" Foreground="#FF065668" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbStatus" Height="35" Padding="10,0" FontSize="14"
                                         BorderBrush="#FF065668" BorderThickness="1" Background="White">
                                    <ComboBoxItem Content="Active" IsSelected="True"/>
                                    <ComboBoxItem Content="Inactive"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Spacer for alignment -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,30">
                                <!-- Empty for alignment -->
                            </StackPanel>

                            <!-- Required Fields Note -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" 
                                      Text="* Required fields" 
                                      FontStyle="Italic" Foreground="Gray" 
                                      Margin="0,0,0,20" FontSize="12"/>

                            <!-- Buttons -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" 
                                       Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Button x:Name="btnSave" Content="💾 Save Employee" 
                                       Width="150" Height="40" Margin="0,0,15,0"
                                       Background="#FF065668" BorderBrush="#FF065668" 
                                       Foreground="White" FontSize="14" FontWeight="SemiBold"
                                       Cursor="Hand" Click="btnSave_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                               CornerRadius="5" BorderThickness="1" 
                                                               BorderBrush="{TemplateBinding BorderBrush}">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                                                            VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF054A5C"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="btnCancel" Content="❌ Cancel" 
                                       Width="120" Height="40" Margin="15,0,0,0"
                                       Background="White" BorderBrush="#FFDC3545" 
                                       Foreground="#FFDC3545" FontSize="14" FontWeight="SemiBold"
                                       Cursor="Hand" Click="btnCancel_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                               CornerRadius="5" BorderThickness="2" 
                                                               BorderBrush="{TemplateBinding BorderBrush}">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                                                            VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FFDC3545"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>