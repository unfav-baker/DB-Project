<Window x:Class="Dashboard.Window3_b"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       mc:Ignorable="d"
       Title="Prime Tech"
       Height="450"
       Width="800"
       WindowStartupLocation="CenterScreen"
       ResizeMode="CanResize"
        WindowState="Maximized"
       Background="#FFE4E9EF">
    

    <Window.Resources>
        <Style x:Key="AuthButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF0080C3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0056B3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#003D7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                        <Border Background="{TemplateBinding Background}"
                               CornerRadius="15"
                               Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                            <!--<ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0056B3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>-->
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Top-left Return Hyperlink -->
        <TextBlock HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="10,10,0,0"
                  FontSize="14"
                  FontWeight="Bold">
           <Hyperlink Click="ReturnToPreviousPage">
               ← Return
           </Hyperlink>
        </TextBlock>

        <!-- Main Content Grid -->
        <Grid Margin="30,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.7*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Content -->
            <Grid Grid.Column="0"
                 VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Image Grid.Row="0"
                      Source="Images/dsd.png"
                      
                      Margin="-95,-86,206,4" Grid.RowSpan="2"/>

                <!-- Title -->
                <TextBlock Grid.Row="1"
                          Text="PRIME TECH"
                          FontSize="60"
                          FontWeight="Bold"
                          Foreground="#FF014860"
                          FontFamily="Segoe UI Black"
                          Margin="0,0,0,10"
                          HorizontalAlignment="Center"/>

                <!-- Subtitle -->
                <TextBlock Grid.Row="2"
                          Text="Seamless Exports, Trusted Solutions"
                          FontSize="16"
                          FontWeight="Bold"
                          Margin="0,0,0,10"
                          HorizontalAlignment="Center"/>

                <!-- Social Media -->
                <StackPanel Grid.Row="3"
                           Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,0,0,30">
                    <TextBlock Text="Follow us on:"
                              FontSize="14"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <Button Width="24" Height="24" Margin="0,0,10,0" Click="Facebook_Click" Background="Transparent" BorderThickness="0">
                        <Image Source="Images/Facebook.png"/>
                    </Button>
                    <Button Width="24" Height="24" Margin="0,0,10,0" Click="X_Click" Background="Transparent" BorderThickness="0">
                        <Image Source="Images/X.png"/>
                    </Button>
                    <Button Width="24" Height="24" Click="Instagram_Click" Background="Transparent" BorderThickness="0">
                        <Image Source="Images/Instagram.png"/>
                    </Button>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="4"
                           Orientation="Horizontal"
                           HorizontalAlignment="Center">
                    <Button Content="Sign In"
                           Style="{StaticResource AuthButtonStyle}"
                           Margin="0,0,20,0"
                           Click="SignIn_Click"/>
                    <Button Content="Sign Up"
                           Style="{StaticResource AuthButtonStyle}"
                            Click="SignUp_Click"/>
                </StackPanel>
            </Grid>

            <!-- Right Image Section -->
            <Border Grid.Column="1">
                <Viewbox Stretch="Uniform">
                    <Image Source="Images/Watercolor and earth map vector - WeLoveSoLo.jpg"
                          Stretch="UniformToFill"/>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</Window>
