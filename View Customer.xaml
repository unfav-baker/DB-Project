<Page x:Class="Employee.View_Customer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Employee" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="View Customers &amp; Their Orders" Background="#FFF0F2F5">
    <Page.Resources>
        <Style x:Key="CustomerCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="MinHeight" Value="190"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.1" ShadowDepth="1" Color="#FFAAAAAA"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectedCustomerCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CustomerCardBorderStyle}">
            <Setter Property="BorderBrush" Value="#FF065668"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="3" Color="#FF065668"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomerTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF065668"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CustomerDetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,5,3"/>
        </Style>
        <Style x:Key="CustomerDetailValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="61"/>
            <RowDefinition Height="Auto" MinHeight="210"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF065668">
            <TextBlock Text="👥 Customers &amp; Orders" HorizontalAlignment="Left" VerticalAlignment="Center" 
                       Margin="20,0,0,0" Foreground="White" FontSize="22" FontWeight="Bold"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="250" Padding="5,0,5,5">
            <ItemsControl ItemsSource="{Binding CustomersList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CustomerDisplayData}">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Click="CustomerCard_Click" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Border x:Name="CustomerCardBorder" Style="{StaticResource CustomerCardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CustomerTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Phone:" Style="{StaticResource CustomerDetailLabelStyle}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PhoneNumber}" Style="{StaticResource CustomerDetailValueStyle}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" Style="{StaticResource CustomerDetailLabelStyle}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Email}" Style="{StaticResource CustomerDetailValueStyle}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Address:" Style="{StaticResource CustomerDetailLabelStyle}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Address}" Style="{StaticResource CustomerDetailValueStyle}" MaxHeight="35" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Type:" Style="{StaticResource CustomerDetailLabelStyle}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CustomerType}" Style="{StaticResource CustomerDetailValueStyle}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:" Style="{StaticResource CustomerDetailLabelStyle}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status}" Style="{StaticResource CustomerDetailValueStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelectedAsCurrent}" Value="True">
                                <Setter TargetName="CustomerCardBorder" Property="Style" Value="{StaticResource SelectedCustomerCardBorderStyle}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Rectangle Grid.Row="2" Fill="#DDDDDD" Height="1" Margin="10,0"/>

        <Grid Grid.Row="3" Margin="10,5,10,10">
            <TextBlock Text="Orders for Selected Customer:" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#333"/>
            <DataGrid x:Name="OrdersDataGrid" ItemsSource="{Binding SelectedCustomerOrders}" 
                      AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,30,0,0"
                      HeadersVisibility="Column" IsReadOnly="True" SelectionMode="Single" 
                      BorderBrush="#CCCCCC" BorderThickness="1"
                      HorizontalGridLinesBrush="#FFE0E0E0" VerticalGridLinesBrush="#FFE0E0E0"
                      RowBackground="White" AlternatingRowBackground="#FFF9F9F9"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCustomer}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" MinWidth="70" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat='dd/MM/yyyy'}" MinWidth="90" Width="Auto"/>
                    <DataGridTextColumn Header="Export Through" Binding="{Binding ExportThrough}" MinWidth="120" Width="1.5*"/>
                    <DataGridTextColumn Header="Plant" Binding="{Binding Plant}" MinWidth="100" Width="1.2*"/>
                    <DataGridTextColumn Header="Importer" Binding="{Binding Importer}" MinWidth="120" Width="1.5*"/>
                    <DataGridTextColumn Header="Phyto Num" Binding="{Binding PhytoNumber}" MinWidth="100" Width="*"/>
                    <DataGridTextColumn Header="Cartons" Binding="{Binding Carton}" MinWidth="60" Width="Auto" ElementStyle="{StaticResource RightAlignedCellStyle}"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat=C}" MinWidth="90" Width="*" ElementStyle="{StaticResource RightAlignedCellStyle}"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" MinWidth="90" Width="*" ElementStyle="{StaticResource RightAlignedCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Select a customer above to view their orders." FontSize="14" Foreground="Gray" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCustomer}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Page>
