<Page x:Class="Employee.CreateReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Employee"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="Create New Order Entry" Background="#FFF0F2F5">
    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="FormLabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF065668"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FormInputStyle">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#FFABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF7EB4EA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF065668"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFEFEFEF"/>
                                <Setter Property="Foreground" Value="#FF555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" x:Key="FormComboBoxStyle">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#FFABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DatePicker" x:Key="FormDatePickerStyle">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#FFABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button" x:Key="FormSaveButtonStyle">
            <Setter Property="Background" Value="#FF065668"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF065668"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="FormClearButtonStyle">
            <Setter Property="Background" Value="#FFE0E0E0"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="HeaderClosePageButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Content" Value="&#xE10A;"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="ToolTip" Value="Close"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="17.5">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="61"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF065668">
            <Grid>
                <TextBlock Text="➕ Create New Order Entry" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <Button Click="ClosePageButton_Click" Style="{StaticResource HeaderClosePageButtonStyle}"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Border Background="White" CornerRadius="5" Padding="25" MaxWidth="750" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,20">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Color="#FFCCCCCC" Opacity="0.4" BlurRadius="10"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Order Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#333"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Order Date*" Style="{StaticResource FormLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding OrderDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormDatePickerStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Product*" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox x:Name="ProductComboBox" 
                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:CreateReportPage}, Path=AvailableProducts}" 
                                      DisplayMemberPath="Name" 
                                      SelectedValuePath="ProductId" 
                                      SelectedValue="{Binding SelectedProductId, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedItem="{Binding CurrentSelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Quantity*" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}" PreviewTextInput="NumericOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Total Amount*" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding TotalAmount, Mode=OneWay, StringFormat=N2}" Style="{StaticResource FormInputStyle}" IsReadOnly="True" Background="#FFEFEFEF"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Export Through" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding ExportThrough, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Phyto Number" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding PhytoNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Carton" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Carton, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}" PreviewTextInput="NumericOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="7" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Order Status*" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox SelectedValue="{Binding OrderStatus, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource FormComboBoxStyle}">
                                <ComboBoxItem Content="Pending" IsSelected="True"/>
                                <ComboBoxItem Content="Processing"/>
                                <ComboBoxItem Content="Shipped"/>
                                <ComboBoxItem Content="Delivered"/>
                                <ComboBoxItem Content="Cancelled"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="8" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Plant (Detail/Location)" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Plant, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="9" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Delivery Date" Style="{StaticResource FormLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding DeliveryDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormDatePickerStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Customer (Party Name)*" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox x:Name="CustomerComboBox" 
                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:CreateReportPage}, Path=AvailableCustomers}" 
                                      DisplayMemberPath="Name" SelectedValuePath="CustomerId" 
                                      SelectedValue="{Binding SelectedCustomerId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Supplier (Optional)" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox x:Name="SupplierComboBox" 
                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:CreateReportPage}, Path=AvailableSuppliers}" 
                                      DisplayMemberPath="Name" SelectedValuePath="SupplierId" 
                                      SelectedValue="{Binding SelectedSupplierId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Rate (per unit)*" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Rate, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}" PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Amount Received" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding AmountReceived, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}" PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Vehicle No." Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding VehicleNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Weight" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Weight, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}" PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Row="7" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Payment Status*" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox SelectedValue="{Binding PaymentStatus, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource FormComboBoxStyle}">
                                <ComboBoxItem Content="Pending" IsSelected="True"/>
                                <ComboBoxItem Content="Partially Paid"/>
                                <ComboBoxItem Content="Paid"/>
                                <ComboBoxItem Content="Refunded"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                        <Button Content="Clear Form" Click="ClearFormButton_Click" Style="{StaticResource FormClearButtonStyle}" Margin="0,0,10,0"/>
                        <Button x:Name="SaveOrderButton" Content="Save Order" Click="SaveButton_Click" Style="{StaticResource FormSaveButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
