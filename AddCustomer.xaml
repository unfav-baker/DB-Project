<Page x:Class="Adminn.AddCustomer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Add Customer">

    <Grid>
         <!--Header--> 
        <Grid Background="#FF065668" Height="61" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" 
                  Margin="24,13,0,0" 
                  TextWrapping="Wrap" 
                  Text="➕ Add New Customer" 
                  VerticalAlignment="Top" 
                  Width="300" 
                  Foreground="White" 
                  Background="#FF065668" 
                  FontSize="22" 
                  FontWeight="Bold"/>

         <!--Main Content--> 
        <ScrollViewer Margin="20,70,20,60" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                 <!--Date--> 
                <TextBlock Text="Date:" 
                          Grid.Row="0" Grid.Column="0" 
                          FontWeight="Bold" 
                          Margin="0,10,0,5" 
                          VerticalAlignment="Center"/>
                <DatePicker x:Name="DatePicker" 
                           Grid.Row="0" Grid.Column="1" 
                           Margin="10,10,0,5" 
                           Height="30"/>

                 <!--Phyto Number--> 
                <TextBlock Text="Phyto Number:" 
                          Grid.Row="1" Grid.Column="0" 
                          FontWeight="Bold" 
                          Margin="0,10,0,5" 
                          VerticalAlignment="Center"/>
                <TextBox x:Name="PhytoNumberTextBox" 
                        Grid.Row="1" Grid.Column="1" 
                        Margin="10,10,0,5" 
                        Height="30" 
                        VerticalContentAlignment="Center"/>

                 <!--Party Name--> 
                <TextBlock Text="Party Name:" 
                          Grid.Row="2" Grid.Column="0" 
                          FontWeight="Bold" 
                          Margin="0,10,0,5" 
                          VerticalAlignment="Center"/>
                <TextBox x:Name="PartyNameTextBox" 
                        Grid.Row="2" Grid.Column="1" 
                        Margin="10,10,0,5" 
                        Height="30" 
                        VerticalContentAlignment="Center"/>

                 <!--Export Through--> 
                <TextBlock Text="Export Through:" 
                          Grid.Row="3" Grid.Column="0" 
                          FontWeight="Bold" 
                          Margin="0,10,0,5" 
                          VerticalAlignment="Center"/>
                <TextBox x:Name="ExportThroughTextBox" 
                        Grid.Row="3" Grid.Column="1" 
                        Margin="10,10,0,5" 
                        Height="30" 
                        VerticalContentAlignment="Center"/>

                 <!--Plant--> 
                <TextBlock Text="Plant:" 
                          Grid.Row="4" Grid.Column="0" 
                          FontWeight="Bold" 
                          Margin="0,10,0,5" 
                          VerticalAlignment="Center"/>
                <TextBox x:Name="PlantTextBox" 
                        Grid.Row="4" Grid.Column="1" 
                        Margin="10,10,0,5" 
                        Height="30" 
                        VerticalContentAlignment="Center"/>

                 <!--Importer--> 
                <TextBlock Text="Importer:" 
                          Grid.Row="5" Grid.Column="0" 
                          FontWeight="Bold" 
                          Margin="0,10,0,5" 
                          VerticalAlignment="Center"/>
                <TextBox x:Name="ImporterTextBox" 
                        Grid.Row="5" Grid.Column="1" 
                        Margin="10,10,0,5" 
                        Height="30" 
                        VerticalContentAlignment="Center"/>

                 <!--Second Column Fields 
                 Carton--> 
                <TextBlock Text="Carton:" 
                          Grid.Row="0" Grid.Column="0" 
                          FontWeight="Bold" 
                          Margin="400,10,0,5" 
                          VerticalAlignment="Center"/>
                <TextBox x:Name="CartonTextBox" 
                        Grid.Row="0" Grid.Column="1" 
                        Margin="200,10,0,5" 
                        Height="30" 
                        VerticalContentAlignment="Center"/>

                 <!--Weight--> 
                <TextBlock Text="Weight:" 
                          Grid.Row="1" Grid.Column="0" 
                          FontWeight="Bold" 
                          Margin="400,10,0,5" 
                          VerticalAlignment="Center"/>
                <TextBox x:Name="WeightTextBox" 
                        Grid.Row="1" Grid.Column="1" 
                        Margin="200,10,0,5" 
                        Height="30" 
                        VerticalContentAlignment="Center"/>

                 <!--Rate--> 
                <TextBlock Text="Rate:" 
                          Grid.Row="2" Grid.Column="0" 
                          FontWeight="Bold" 
                          Margin="400,10,0,5" 
                          VerticalAlignment="Center"/>
                <TextBox x:Name="RateTextBox" 
                        Grid.Row="2" Grid.Column="1" 
                        Margin="200,10,0,5" 
                        Height="30" 
                        VerticalContentAlignment="Center"/>

                 <!--Amount--> 
                <TextBlock Text="Amount:" 
                          Grid.Row="3" Grid.Column="0" 
                          FontWeight="Bold" 
                          Margin="400,10,0,5" 
                          VerticalAlignment="Center"/>
                <TextBox x:Name="AmountTextBox" 
                        Grid.Row="3" Grid.Column="1" 
                        Margin="200,10,0,5" 
                        Height="30" 
                        VerticalContentAlignment="Center"/>

                 <!--Received--> 
                <TextBlock Text="Received:" 
                          Grid.Row="4" Grid.Column="0" 
                          FontWeight="Bold" 
                          Margin="400,10,0,5" 
                          VerticalAlignment="Center"/>
                <TextBox x:Name="ReceivedTextBox" 
                        Grid.Row="4" Grid.Column="1" 
                        Margin="200,10,0,5" 
                        Height="30" 
                        VerticalContentAlignment="Center"/>
            </Grid>
        </ScrollViewer>

         <!--Bottom Button Panel--> 
        <Grid Height="50" VerticalAlignment="Bottom" Background="White">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Save Customer" 
                       Background="#FF28A745" 
                       BorderBrush="#FF28A745" 
                       Width="120" 
                       Foreground="White" 
                       Height="35" 
                       Click="SaveCustomer_Click" 
                       Margin="0,0,10,0" 
                       FontWeight="Bold"/>
                <Button Content="Cancel" 
                       Background="#FF6C757D" 
                       BorderBrush="#FF6C757D" 
                       Width="80" 
                       Foreground="White" 
                       Height="35" 
                       Click="Cancel_Click" 
                       FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>