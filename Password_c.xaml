<Page x:Class="Dashboard.Password_c"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Dashboard"
      xmlns:CC="clr-namespace:Dashboard.CustomControls"
      Title="Password" Width="374">




    <Border CornerRadius="30" Background="#FFE4E9EF" BorderBrush="#FFE4E9EF" BorderThickness="1">

        <!-- Grid Wrapped in Rounded Border -->
        <Border CornerRadius="20" Margin="65,10,10,10">
            <Grid Margin="-56,0,0,0" Background="#FFE4E9EF">

                <Grid.RowDefinitions>
                    <RowDefinition Height="0*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="327*"/>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="28*"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock HorizontalAlignment="Left" Margin="56,45,0,0" TextWrapping="Wrap" 
                     Text="Reset Password" VerticalAlignment="Top" Foreground="#FF0080C3" 
                     FontWeight="Bold" FontSize="32" Width="335" Grid.Column="2" Grid.ColumnSpan="3" Height="43" Grid.Row="1"/>

                <!-- Subtitle -->

                <!-- Description -->

                <!-- Return Link -->

                <!-- Email Input -->
                <CC:Dashboard  
               x:Name="txtpassword"
                Margin="49,121,0,272"  
                BorderThickness="1"  
                CaretBrush="Black"  
                VerticalContentAlignment="Center"  
                CornerRadius="18"  
                FontFamily="Segoe UI Symbol"  
                FontSize="16"  
                PlaceHolder="Password" BorderBrush="Black" Foreground="Black" 
                Grid.Row="1" HorizontalAlignment="Left" 
                Width="246" Grid.Column="2"  />


                <CC:Dashboard  
x:Name="txtconfirm"
 Margin="49,182,0,211"  
 BorderThickness="1"  
 CaretBrush="Black"  
 VerticalContentAlignment="Center"  
 CornerRadius="18"  
 FontFamily="Segoe UI Symbol"  
 FontSize="16"  
 PlaceHolder="Confirm Password" BorderBrush="Black" Foreground="Black" 
 Grid.Row="1" HorizontalAlignment="Left" 
 Width="246" Grid.Column="2" />

                <!-- Verification Code Input -->

                <!-- Verification Code Label -->

                <!-- Send Reset Link Button -->
                <Button Click="btnSendResetEmail_Click"
                Content="Reset"  
                
                Background="#FF0080C3"  
                Foreground="White"  
                FontSize="14"  
                FontWeight="Bold"  
                Width="160" Height="35"  
                BorderThickness="0"  
                Cursor="Hand"  
                HorizontalAlignment="Left"  
                VerticalAlignment="Top"  
                Margin="96,234,0,0"  
                RenderTransformOrigin="0.656,-1.011" Grid.Column="2" Grid.Row="1">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border"  
                            Background="{TemplateBinding Background}"  
                            CornerRadius="15"  
                            Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF005B9F"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF003F75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Additional Information -->
                <TextBlock HorizontalAlignment="Left" Margin="49,294,0,0" TextWrapping="Wrap" 
                     Text="Remember your password?" VerticalAlignment="Top" Width="180" 
                     FontSize="14" Background="{x:Null}" Grid.Column="2" Height="19" Grid.Row="1"/>

                <TextBlock HorizontalAlignment="Left" Margin="224,294,0,0"  
                VerticalAlignment="Top" FontSize="14" FontWeight="Bold"  
                Foreground="#FF0080C3" TextWrapping="Wrap"  
                Grid.Column="2" Height="19" Grid.Row="1" Width="46">  
                <Hyperlink Click="SignIn_Click" TextDecorations="Underline">  
                    Sign In  
                </Hyperlink>
                </TextBlock>

                <!-- Help Text -->

                <!-- Success/Error Message Placeholder -->
                <TextBlock x:Name="MessageTextBlock" HorizontalAlignment="Left" Margin="16,199,0,0" 
                     TextWrapping="Wrap" VerticalAlignment="Top" Width="246" 
                     FontSize="12" FontWeight="Bold" Grid.Column="2" Visibility="Collapsed" Height="0" Grid.Row="1"/>

                <!-- Decorative Image -->

            </Grid>
        </Border>

    </Border>

</Page>
