<Window
    x:Class="Dashboard.Window4"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CC="clr-namespace:Dashboard.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Dashboard"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Height="450" Width="617"
    Background="Transparent"
    WindowStyle="None"
    ResizeMode="CanMinimize"
    AllowsTransparency="True"
    mc:Ignorable="d">
    <Border CornerRadius="30" Background="#FFE4E9EF" BorderBrush="#FFE4E9EF" BorderThickness="1">
        <!-- Grid Wrapped in Rounded Border -->
        <Border CornerRadius="20" Margin="65,10,10,10">
            <Grid Margin="-56,0,0,0" Background="#FFE4E9EF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="49*"/>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="208*"/>
                    <ColumnDefinition Width="339*"/>
                    <ColumnDefinition Width="0*"/>
                </Grid.ColumnDefinitions>

                <CC:Dashboard
                    x:Name="NameTextBox"
                    Margin="16,132,0,264"
                    BorderThickness="1"
                    CaretBrush="Black"
                     VerticalContentAlignment="Center"
                    CornerRadius="18"
                    FontFamily="Segoe UI Symbol"
                    FontSize="16"
                    PlaceHolder="Username" 
                    BorderBrush="Black" 
                    Foreground="Black" 
                    Grid.Row="1" 
                    Grid.ColumnSpan="2" 
                    Grid.Column="2" HorizontalAlignment="Left" Width="246" />

                <Button 
                    Content="Sign Up"
                    Click="SignUp_Click"
                    Background="#FF0080C3"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold" Height="35"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Top"
                    Margin="80,316,26,0" 
                    RenderTransformOrigin="0.656,-1.011" 
                    Grid.RowSpan="2" 
                    Grid.Column="2"
                    >
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">


                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0056B3"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#003D7A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15"
                                    Padding="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <CC:Dashboard
                    x:Name="EmailTextBox"
                    Margin="16,172,0,224"
                    BorderThickness="1"
                    CaretBrush="Black"
                     VerticalContentAlignment="Center"
 CornerRadius="18"
 FontFamily="Segoe UI Symbol"
                    FontSize="16"
                    PlaceHolder="Email" 
                    BorderBrush="Black" 
                    Foreground="Black" 
                    Grid.Row="1" 
                    Grid.ColumnSpan="2" 
                    Grid.Column="2" HorizontalAlignment="Left" Width="246" />

                <CC:Dashboard
                    x:Name="PasswordTextBox"
                    Margin="16,214,0,182"
                    BorderThickness="1"
                     CaretBrush="Black"
                     VerticalContentAlignment="Center"
 CornerRadius="18"
 FontFamily="Segoe UI Symbol"
                    FontSize="16"
                    PlaceHolder="Password" 
                    BorderBrush="Black" 
                    Foreground="Black" 
                    Grid.Row="1" 
                    Grid.ColumnSpan="2" 
                    Grid.Column="2" HorizontalAlignment="Left" Width="246" 
                    
                    
                    />


                <CC:Dashboard
                    x:Name="ConfirmPasswordTextBox"
                    Margin="16,260,0,136"
                    BorderThickness="1"
                    CaretBrush="Black"
                     VerticalContentAlignment="Center"
 CornerRadius="18"
 FontFamily="Segoe UI Symbol"
                    FontSize="16"
                    PlaceHolder="Confirm Password" 
                    BorderBrush="Black" 
                    Foreground="Black" 
                    Grid.Row="1" 
                    Grid.ColumnSpan="2" 
                    Grid.Column="2" HorizontalAlignment="Left" Width="246" />

                <TextBlock 
                    HorizontalAlignment="Left" 
                    Margin="80,33,0,0" 
                    TextWrapping="Wrap" 
                    Text="Sign Up" 
                    VerticalAlignment="Top" 
                    Foreground="#FF0080C3" 
                    FontWeight="Bold" 
                    FontSize="38" 
                    Width="204" 
                    Grid.Column="2" 
                    Grid.RowSpan="2" 
                    Grid.ColumnSpan="2"/>

                <TextBlock 
                    HorizontalAlignment="Left" 
                    Margin="56,81,0,0" 
                    TextWrapping="Wrap" 
                    Text="Welcome to Prime Tech!" 
                    VerticalAlignment="Top" 
                    FontWeight="Bold" 
                    FontSize="20" 
                    Foreground="Black" 
                    Height="23" 
                    Width="241" 
                    Grid.Column="2" 
                    Grid.RowSpan="2" 
                    Grid.ColumnSpan="2"/>

                <TextBlock
                    Width="182" 
                    VerticalAlignment="Top" 
                    Text="Sign Up to get started" 
                    TextWrapping="Wrap" 
                    Grid.RowSpan="2" 
                    Margin="91,106,0,0" 
                    HorizontalAlignment="Left" 
                    FontSize="14" 
                    Grid.ColumnSpan="2" 
                    Grid.Column="2"/>

                <TextBlock 
                    HorizontalAlignment="Left" 
                    Margin="23,366,0,0" 
                    TextWrapping="Wrap" 
                    Text="Already have an account?" 
                    VerticalAlignment="Top" 
                    Width="180" 
                    FontSize="14"
                    Grid.Column="2" 
                    Grid.RowSpan="2"/>

                <TextBlock 
    Margin="193,366,308,43" 
    TextWrapping="Wrap" 
    FontSize="14" 
    FontWeight="Bold" 
    Foreground="#FF0080C3" 
    Grid.Column="2" 
    Grid.RowSpan="2" 
    Grid.ColumnSpan="2">
    
    <Hyperlink Click="SignIn_Click" TextDecorations="Underline">
        Sign In
    </Hyperlink>
                </TextBlock>


                <TextBlock
           Margin="10,10,187,399"
           FontSize="14"
           FontWeight="Bold" Grid.ColumnSpan="3" Grid.RowSpan="2">
    <Hyperlink Click="ReturnToPreviousPage">
        ← Return
    </Hyperlink>
                </TextBlock>

                <Image 
                    Grid.Column="3" 
                    HorizontalAlignment="Left" 
                    Height="176" 
                    Margin="54,116,0,0" 
                    Grid.RowSpan="2" 
                    VerticalAlignment="Top" 
                    Width="279"  
                    Stretch="Fill" 
                    Source="Images/La_transparence_mutuelle___clé_d_une_relation_client_durable-removebg-preview.png"/>
            </Grid>
        </Border>
    </Border>
</Window>