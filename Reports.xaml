<Page x:Class="Employee.Reports"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Employee"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="Order Reports"
      d:DesignHeight="450" 
      d:DesignWidth="1000" mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="61"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF065668">
            <TextBlock Text=" 📝 Order Reports" 
                       HorizontalAlignment="Left" VerticalAlignment="Center" 
                       Margin="20,0,0,0" Foreground="White" 
                       FontSize="22" FontWeight="Bold"/>
        </Border>

        <DataGrid Grid.Row="1" x:Name="ReportsDataGrid" ItemsSource="{Binding ReportDataList}" 
                  Margin="10" AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True" 
                  SelectionMode="Single" 
                  BorderBrush="#CCCCCC" BorderThickness="1"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat='dd/MM/yyyy'}" Width="100"/>
                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyName}" Width="1.5*"/>
                <DataGridTextColumn Header="Export Through" Binding="{Binding ExportThrough}" Width="1*"/>
                <DataGridTextColumn Header="Plant" Binding="{Binding Plant}" Width="1*"/>
                <DataGridTextColumn Header="Importer" Binding="{Binding Importer}" Width="1*"/>
                <DataGridTextColumn Header="Phyto Number" Binding="{Binding PhytoNumber}" Width="120"/>
                <DataGridTextColumn Header="Carton" Binding="{Binding Carton}" Width="70"/>
                <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:N2}}" Width="80"/>
                <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Received" Binding="{Binding AmountReceived, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Refresh Reports" 
                        Click="RefreshReports_Click" 
                        Background="#FF065668" BorderBrush="#FF065668" 
                        Width="130" Foreground="White" Height="30"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
