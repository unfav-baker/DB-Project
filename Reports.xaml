<Page x:Class="Adminn.Reports"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d"
      d:DesignHeight="450" 
      d:DesignWidth="1200" 
      Title="Order Summaries">

    <Page.Resources>
        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Page.Resources>

    <Grid Background="#FFF0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="61"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF065668">
            <TextBlock Text=" 📝 Order Summaries" 
                       HorizontalAlignment="Left" VerticalAlignment="Center" 
                       Margin="20,0,0,0" Foreground="White" 
                       FontSize="22" FontWeight="Bold"/>
        </Border>

        <DataGrid Grid.Row="1" x:Name="ReportsDataGrid" 
                  ItemsSource="{Binding ReportsList}" 
                  Margin="10" AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True" 
                  SelectionMode="Single" 
                  BorderBrush="#CCCCCC" BorderThickness="1"
                  HorizontalGridLinesBrush="#FFE0E0E0" VerticalGridLinesBrush="#FFE0E0E0"
                  RowBackground="White" AlternatingRowBackground="#FFF9F9F9"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="40" Header="" Binding="{Binding IsSelected}" CanUserResize="False"/>

                <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" MinWidth="70" Width="Auto"/>
                <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat='dd/MM/yyyy'}" MinWidth="90" Width="Auto"/>
                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyName}" MinWidth="150" Width="2*"/>
                <DataGridTextColumn Header="Export Through" Binding="{Binding ExportThrough}" MinWidth="120" Width="1.2*"/>
                <DataGridTextColumn Header="Plant" Binding="{Binding Plant}" MinWidth="100" Width="1.2*"/>
                <DataGridTextColumn Header="Importer" Binding="{Binding Importer}" MinWidth="120" Width="1.2*"/>
                <DataGridTextColumn Header="Phyto Number" Binding="{Binding PhytoNumber}" MinWidth="110" Width="*"/>

                <DataGridTextColumn Header="Carton" Binding="{Binding Carton}" MinWidth="60" Width="Auto" ElementStyle="{StaticResource RightAlignedCellStyle}"/>
                <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:N2}}" MinWidth="70" Width="Auto" ElementStyle="{StaticResource RightAlignedCellStyle}"/>
                <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=C}" MinWidth="80" Width="Auto" ElementStyle="{StaticResource RightAlignedCellStyle}"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat=C}" MinWidth="90" Width="*" ElementStyle="{StaticResource RightAlignedCellStyle}"/>
                <DataGridTextColumn Header="Received" Binding="{Binding AmountReceived, StringFormat=C}" MinWidth="90" Width="*" ElementStyle="{StaticResource RightAlignedCellStyle}"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" MinWidth="90" Width="*" ElementStyle="{StaticResource RightAlignedCellStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="View Report Page" 
                            Click="ViewReport_Click" 
                            Background="#FF065668" BorderBrush="#FF065668" 
                            Padding="10,7" Margin="0,0,10,0"
                            Foreground="White" Height="30" FontWeight="SemiBold"/>
                    <Button Content="👁" ToolTip="View Selected Order Details" 
                            Background="#6C757D" BorderBrush="#6C757D" 
                            Width="35" Foreground="White" Height="30" Margin="0,0,5,0" FontSize="14" 
                            Click="ViewReportDetails_Click"/>
                    <Button Content="🗑" ToolTip="Delete Selected Order" 
                            Background="#DC3545" BorderBrush="#DC3545" 
                            Width="35" Foreground="White" Height="30" FontSize="14" 
                            Click="DeleteReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
