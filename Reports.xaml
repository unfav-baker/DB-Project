<Page x:Class="Employee.Reports"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Employee"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="Order Reports"
      d:DesignHeight="450" 
      d:DesignWidth="1200" 
      mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="RightAlignedTextCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Page.Resources>

    <Grid Background="#FFF0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="61"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF065668">
            <TextBlock Text=" 📝 Order Reports" 
                       HorizontalAlignment="Left" VerticalAlignment="Center" 
                       Margin="20,0,0,0" Foreground="White" 
                       FontSize="22" FontWeight="Bold"/>
        </Border>

        <DataGrid Grid.Row="1" x:Name="ReportsDataGrid"
                  ItemsSource="{Binding ReportDataList}" 
                  Margin="10" AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True" 
                  SelectionMode="Single" 
                  BorderBrush="#FFCCCCCC" BorderThickness="1"
                  HorizontalGridLinesBrush="#FFE0E0E0" VerticalGridLinesBrush="#FFE0E0E0"
                  RowBackground="White" AlternatingRowBackground="#FFF9F9F9"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat='dd/MM/yyyy'}" MinWidth="90" Width="Auto"/>
                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyName}" MinWidth="150" Width="2*"/>
                <DataGridTextColumn Header="Export Through" Binding="{Binding ExportThrough}" MinWidth="120" Width="1.5*"/>
                <DataGridTextColumn Header="Plant" Binding="{Binding Plant}" MinWidth="100" Width="1.5*"/>
                <DataGridTextColumn Header="Importer" Binding="{Binding Importer}" MinWidth="120" Width="1.5*"/>
                <DataGridTextColumn Header="Phyto Number" Binding="{Binding PhytoNumber}" MinWidth="110" Width="Auto"/>

                <DataGridTextColumn Header="Carton" Binding="{Binding Carton}" MinWidth="60" Width="Auto" ElementStyle="{StaticResource RightAlignedTextCellStyle}"/>
                <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:N2}}" MinWidth="70" Width="Auto" ElementStyle="{StaticResource RightAlignedTextCellStyle}"/>
                <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=C}" MinWidth="80" Width="Auto" ElementStyle="{StaticResource RightAlignedTextCellStyle}"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat=C}" MinWidth="90" Width="*" ElementStyle="{StaticResource RightAlignedTextCellStyle}"/>
                <DataGridTextColumn Header="Received" Binding="{Binding AmountReceived, StringFormat=C}" MinWidth="90" Width="*" ElementStyle="{StaticResource RightAlignedTextCellStyle}"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" MinWidth="90" Width="*" ElementStyle="{StaticResource RightAlignedTextCellStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#FFF5F5F5" BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Refresh Reports" 
                        Click="RefreshReports_Click" 
                        Background="#FF065668" BorderBrush="#FF065668" 
                        Padding="12,7"
                        Foreground="White" FontWeight="SemiBold" FontSize="13">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
