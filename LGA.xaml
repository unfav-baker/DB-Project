<Window  
    x:Class="Adminn.LGA"  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
    xmlns:CC="clr-namespace:Adminn.CustomControls"  
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
    xmlns:local="clr-namespace:Adminn"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
    Title="Logout Successful"  
    Height="450" Width="617"  
    Background="Transparent"  
    WindowStyle="None"  
    AllowsTransparency="True"  
    mc:Ignorable="d">

    <!-- Rounded Window -->
    <Border CornerRadius="30" Background="#FFE4E9EF" BorderBrush="#FFE4E9EF" BorderThickness="1">

        <!-- Grid Wrapped in Rounded Border -->
        <Border CornerRadius="20" Margin="65,10,10,10">
            <Grid Margin="-56,0,0,0" Background="#FFE4E9EF">

                <Grid.RowDefinitions>
                    <RowDefinition Height="0*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="49*"/>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="208*"/>
                    <ColumnDefinition Width="339*"/>
                    <ColumnDefinition Width="0*"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock HorizontalAlignment="Left" Margin="59,28,0,0" TextWrapping="Wrap" 
                         Text="Logged Out" VerticalAlignment="Top" Foreground="#FF0080C3" 
                         FontWeight="Bold" FontSize="32" Width="335" Grid.Column="2" 
                         Grid.RowSpan="2" Grid.ColumnSpan="2"/>

                <!-- Subtitle -->
                <TextBlock  Margin="21,71,224,0" TextWrapping="Wrap" 
                         Text="You've been successfully logged out" VerticalAlignment="Top" 
                         FontWeight="Bold" FontSize="16" Foreground="Black" Height="24" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2"/>

                <!-- Description -->
                <TextBlock HorizontalAlignment="Left" Margin="21,100,0,0" TextWrapping="Wrap" 
                         Text="Thank you for using our application. Your session has ended safely." 
                         VerticalAlignment="Top" Width="260" Background="{x:Null}" FontSize="12" 
                         Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-0.273"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- Status Icon -->
                <Border Grid.Column="2" Grid.Row="1" Width="80" Height="80" 
                       Background="#FFE4E9EF" CornerRadius="40" BorderBrush="#FF0080C3" 
                       BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" 
                       Margin="110,145,0,0">
                    <!-- Checkmark Icon -->
                    <Path Data="M31.5,46.5 L40.5,55.5 L58.5,30.5" Stroke="#FF0080C3" 
                         StrokeThickness="3" Stretch="Uniform" Width="40" Height="40" 
                         StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                         StrokeLineJoin="Round"/>
                </Border>

                <!-- Exit Button -->
                <Button Content="Close Application"  
                    Click="CloseApplication_Click"  
                    Background="#FF0080C3"  
                    Foreground="White"  
                    FontSize="14"  
                    FontWeight="Bold"  
                    Width="160" Height="35"  
                    BorderThickness="0"  
                    Cursor="Hand"  
                    HorizontalAlignment="Left"  
                    VerticalAlignment="Top"  
                    Margin="71,271,0,0"  
                    Grid.RowSpan="2" Grid.Column="2" Grid.ColumnSpan="2">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border"  
                                Background="{TemplateBinding Background}"  
                                CornerRadius="15"  
                                Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF005B9F"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF003F75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Security Note -->
                <TextBlock HorizontalAlignment="Left" Margin="21,350,0,0" TextWrapping="Wrap" 
                         Text="For security reasons, please close your browser if you're on a public computer." 
                         VerticalAlignment="Top" Width="260" FontSize="10" FontStyle="Italic"
                         Foreground="Gray" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2"/>

                <!-- Decorative Image -->
                <Image Grid.Column="3" HorizontalAlignment="Left" Height="264" 
                      Margin="94,113,0,0" Grid.RowSpan="2" VerticalAlignment="Top" 
                      Width="225" Stretch="Fill" 
                      Source="/Images/LG..jpg"/>

                <!-- Return to Sign In Link -->
                <!--<TextBlock HorizontalAlignment="Left" Margin="45,320,0,0" TextWrapping="Wrap" 
                         Text="Want to sign in again?" VerticalAlignment="Top" Width="140" 
                         FontSize="14" Background="{x:Null}" Grid.Column="2" Grid.RowSpan="2"/>

                <TextBlock HorizontalAlignment="Left" Margin="195,320,0,0"  
                    VerticalAlignment="Top" FontSize="14" FontWeight="Bold"  
                    Foreground="#FF0080C3" TextWrapping="Wrap"  
                    Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2">  
                    <Hyperlink Click="ReturnToSignIn" TextDecorations="Underline">  
                        Sign In  
                    </Hyperlink>
                </TextBlock>-->

            </Grid>
        </Border>

    </Border>
</Window>