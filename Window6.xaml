<Window
    x:Class="Dashboard.Window6"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CC="clr-namespace:Dashboard.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Dashboard"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Height="450" Width="617"
    Background="Transparent"
 WindowStyle="None"
 AllowsTransparency="True"
    mc:Ignorable="d">


    <!-- Rounded Window -->
    <Border CornerRadius="30" Background="#FFE4E9EF" BorderBrush="#FFE4E9EF" BorderThickness="1">

        <!-- Grid Wrapped in Rounded Border -->
        <Border CornerRadius="20" Margin="65,10,10,10">
            <Grid Margin="-56,0,0,0" Background="#FFE4E9EF">

                <Grid.RowDefinitions>
                    <RowDefinition Height="0*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="49*"/>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="208*"/>
                    <ColumnDefinition Width="339*"/>
                    <ColumnDefinition Width="0*"/>
                </Grid.ColumnDefinitions>


                <CC:Dashboard
                        x:Name="EmailInput"
    Margin="16,132,0,264"
   BorderThickness="1"
      CaretBrush="Black"
                    VerticalContentAlignment="Center"
      CornerRadius="18"
      FontFamily="Segoe UI Symbol"
      FontSize="16"
      PlaceHolder="Email" BorderBrush="Black" Foreground="Black" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="2" HorizontalAlignment="Left" Width="246" />

                <Button Content="Sign In"
        Click="SignIn_Click"
        Background="#FF0080C3"
        Foreground="White"
        FontSize="14"
        FontWeight="Bold"
        Width="124" Height="35"
        BorderThickness="0"
        Cursor="Hand"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="74,314,0,0"
        RenderTransformOrigin="0.656,-1.011"
        Grid.RowSpan="2" Grid.Column="2">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="15"
                    Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF005B9F"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF003F75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <CC:Dashboard
                    
                     x:Name="PasswordInput"
                    Margin="16,182,0,214"
                    BorderThickness="1"
                    CaretBrush="Black"
                    VerticalContentAlignment="Center"
                    CornerRadius="18"
                    FontFamily="Segoe UI Symbol"
                    FontSize="16"
                    PlaceHolder="Password" BorderBrush="Black" Foreground="Black" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="2" HorizontalAlignment="Left" Width="246" />


                <TextBlock HorizontalAlignment="Left" Margin="80,33,0,0" TextWrapping="Wrap" Text="Sign In" VerticalAlignment="Top" Foreground="#FF0080C3" FontWeight="Bold" FontSize="32" Width="204" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2"/>

                <TextBlock
       Margin="10,10,187,399"
       FontSize="14"
       FontWeight="Bold" Grid.ColumnSpan="3" Grid.RowSpan="2">
<Hyperlink Click="ReturnToPreviousPage">
    ← Return
</Hyperlink>
                </TextBlock>


                <TextBlock HorizontalAlignment="Left" Margin="80,81,0,0" TextWrapping="Wrap" Text="Welcome Back!" VerticalAlignment="Top" FontWeight="Bold" FontSize="16" Foreground="Black" Height="19" Width="150" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2"/>


                <TextBlock HorizontalAlignment="Left" Margin="67,102,0,0" TextWrapping="Wrap" Text="Login to your existing account" VerticalAlignment="Top" Width="182" Background="{x:Null}"  FontSize="10" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2"/>


                <TextBlock HorizontalAlignment="Left" Margin="16,355,0,0" TextWrapping="Wrap" Text="Don't have an account?" VerticalAlignment="Top" Width="160" FontSize="14"  Background="{x:Null}" Grid.Column="2" Grid.RowSpan="2"/>


                <TextBlock HorizontalAlignment="Left" Margin="170,356,0,0"
           VerticalAlignment="Top" FontSize="14" FontWeight="Bold"
           Foreground="#FF0080C3" TextWrapping="Wrap"
           Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2">
    <Hyperlink Click="SignUp_Click" TextDecorations="Underline">
        Sign Up
    </Hyperlink>
                </TextBlock>


                <CheckBox
                          x:Name="RememberMeCheckbox"
                    Grid.Column="2" Content="Remember Me" 
          HorizontalAlignment="Left" Margin="16,277,0,0" 
          Grid.RowSpan="2" VerticalAlignment="Top" 
          Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
                <TextBlock HorizontalAlignment="Left" Margin="149,273,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" FontSize="14" FontWeight="Bold" Foreground="#FF0080C3" TextDecorations="Underline" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2">
      <Hyperlink Click="ForgotPassword_Click">
          Forget Password!
      </Hyperlink>
                </TextBlock>
                <Image Grid.Column="3" HorizontalAlignment="Left" Height="308" Margin="27,41,0,0" Grid.RowSpan="2" VerticalAlignment="Top" Width="340"  Stretch="Fill" Grid.ColumnSpan="2" Source="Images/download-removebg-preview.png"/>


            </Grid>
        </Border>

    </Border>
</Window>
