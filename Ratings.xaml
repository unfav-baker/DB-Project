<Page x:Class="Adminn.Ratings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Supplier Ratings"
      Background="#F8F8F8">

    <Page.Resources>
        <Style x:Key="RatingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RatingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF065668"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="StarStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" Height="1100">
            <!-- Header -->
            <TextBlock Text="Supplier Ratings"
                     FontSize="28"
                     FontWeight="Bold"
                     Foreground="#FF065668"
                     Margin="0,0,0,30"/>

            <!-- Rating Summary Cards -->
            <WrapPanel HorizontalAlignment="Center">
                <!-- Overall Rating Card -->
                <Border Style="{StaticResource RatingCardStyle}" Width="300" Height="150">
                    <StackPanel>
                        <TextBlock Text="⭐ Overall Rating" Style="{StaticResource RatingTitleStyle}"/>
                        <TextBlock Text="4.7/5" FontSize="32" Foreground="#505050" HorizontalAlignment="Center"/>
                        <TextBlock Text="Based on 45 reviews" 
                                 Foreground="#A0A0A0"
                                 HorizontalAlignment="Center"
                                 Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Recent Rating Card -->
                <Border Style="{StaticResource RatingCardStyle}" Width="300" Height="150">
                    <StackPanel>
                        <TextBlock Text="📅 Last Month" Style="{StaticResource RatingTitleStyle}"/>
                        <TextBlock Text="4.8/5" FontSize="32" Foreground="#505050" HorizontalAlignment="Center"/>
                        <TextBlock Text="From 12 reviews" 
                                 Foreground="#A0A0A0"
                                 HorizontalAlignment="Center"
                                 Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Rating Breakdown -->
            <Border Style="{StaticResource RatingCardStyle}" Margin="20" Padding="25">
                <StackPanel>
                    <TextBlock Text="Detailed Ratings Breakdown" 
                             Style="{StaticResource RatingTitleStyle}"
                             Margin="0,0,0,20"/>

                    <!-- Rating Items -->
                    <StackPanel Margin="0,10">
                        <!-- Rating 1 -->
                        <Border Padding="15" Background="#F8F8F8" CornerRadius="8" Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Quality of Products" Foreground="#505050"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="★★★★★" Style="{StaticResource StarStyle}"/>
                                        <TextBlock Text="4.9" Foreground="#505050" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="Excellent" 
                                         Foreground="#2E7D32"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Rating 2 -->
                        <Border Padding="15" Background="#F8F8F8" CornerRadius="8" Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Delivery Time" Foreground="#505050"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="★★★★☆" Style="{StaticResource StarStyle}"/>
                                        <TextBlock Text="4.2" Foreground="#505050" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="Good" 
                                         Foreground="#1E88E5"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Rating 3 -->
                        <Border Padding="15" Background="#F8F8F8" CornerRadius="8" Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Customer Support" Foreground="#505050"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="★★★★★" Style="{StaticResource StarStyle}"/>
                                        <TextBlock Text="4.7" Foreground="#505050" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="Excellent" 
                                         Foreground="#2E7D32"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recent Reviews -->
            <Border Style="{StaticResource RatingCardStyle}" Margin="20" Padding="25">
                <StackPanel>
                    <TextBlock Text="Recent Reviews" 
                             Style="{StaticResource RatingTitleStyle}"
                             Margin="0,0,0,20"/>

                    <!-- Review 1 -->
                    <Border Padding="15" Background="#F8F8F8" CornerRadius="8" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="example - example" FontWeight="Medium"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="★★★★★" Style="{StaticResource StarStyle}"/>
                                <TextBlock Text="Excellent quality and fast delivery!" Foreground="#505050"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Review 2 -->
                    <Border Padding="15" Background="#F8F8F8" CornerRadius="8" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="example. - example" FontWeight="Medium"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="★★★★☆" Style="{StaticResource StarStyle}"/>
                                <TextBlock Text="Good experience overall" Foreground="#505050"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Refresh Button -->
            <Button Content="🔄 Refresh Ratings"
                    Background="#FF065668"
                    Foreground="White"
                    FontSize="16"
                    Padding="20,10"
                    Margin="20"
                    HorizontalAlignment="Center"
                    BorderThickness="0"
                    Cursor="Hand"
                    Width="250">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0A768C"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        
    </ScrollViewer>
</Page>