<Page x:Class="Adminn.AddProduct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddProduct">
    <Grid>
        <!-- Header -->
        <Grid Background="#FF065668" Height="61" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" 
                  Margin="24,13,0,0" 
                  TextWrapping="Wrap" 
                  Text="➕ Add New Product" 
                  VerticalAlignment="Top" 
                  Width="300" 
                  Foreground="White" 
                  Background="#FF065668"  
                  FontSize="22" 
                  FontWeight="Bold"/>

        <!-- Form Content -->
        <Grid Margin="50,80,50,50" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form Title -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" 
                      Text="Product Information" 
                      FontSize="20" 
                      FontWeight="Bold" 
                      Margin="0,0,0,20" 
                      HorizontalAlignment="Center"
                      Foreground="#FF065668"/>

            <!-- Supplier ID -->
            <Label Grid.Row="1" Grid.Column="0" 
                   Content="Supplier ID:" 
                   VerticalAlignment="Center" 
                   FontWeight="Bold" 
                   Margin="0,5"/>
            <ComboBox x:Name="cmbSupplierId" 
                      Grid.Row="1" Grid.Column="1" 
                      Height="30" 
                      Margin="10,5" 
                      VerticalContentAlignment="Center"
                      DisplayMemberPath="DisplayText"
                      SelectedValuePath="SupplierId"/>

            <!-- Category -->
            <Label Grid.Row="1" Grid.Column="2" 
                   Content="Category:" 
                   VerticalAlignment="Center" 
                   FontWeight="Bold" 
                   Margin="20,5,0,5"/>
            <ComboBox x:Name="cmbCategory" 
                      Grid.Row="1" Grid.Column="3" 
                      Height="30" 
                      Margin="10,5" 
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="Flowers"/>
                <ComboBoxItem Content="Seeds"/>
                <ComboBoxItem Content="Herbs"/>
                <ComboBoxItem Content="Tropical Plants"/>
                <ComboBoxItem Content="Indoor Plants"/>
                <ComboBoxItem Content="Outdoor Plants"/>
                <ComboBoxItem Content="Succulents"/>
                <ComboBoxItem Content="Tools"/>
                <ComboBoxItem Content="Fertilizers"/>
                <ComboBoxItem Content="Pots"/>
            </ComboBox>

            <!-- Quantity -->
            <Label Grid.Row="2" Grid.Column="0" 
                   Content="Quantity:" 
                   VerticalAlignment="Center" 
                   FontWeight="Bold" 
                   Margin="0,5"/>
            <TextBox x:Name="txtQuantity" 
                     Grid.Row="2" Grid.Column="1" 
                     Height="30" 
                     Margin="10,5" 
                     VerticalContentAlignment="Center"/>

            <!-- Price -->
            <Label Grid.Row="2" Grid.Column="2" 
                   Content="Price:" 
                   VerticalAlignment="Center" 
                   FontWeight="Bold" 
                   Margin="20,5,0,5"/>
            <TextBox x:Name="txtPrice" 
                     Grid.Row="2" Grid.Column="3" 
                     Height="30" 
                     Margin="10,5" 
                     VerticalContentAlignment="Center"/>

            <!-- Batch No -->
            <Label Grid.Row="3" Grid.Column="0" 
                   Content="Batch No:" 
                   VerticalAlignment="Center" 
                   FontWeight="Bold" 
                   Margin="0,5"/>
            <TextBox x:Name="txtBatchNo" 
                     Grid.Row="3" Grid.Column="1" 
                     Height="30" 
                     Margin="10,5" 
                     VerticalContentAlignment="Center"/>

            <!-- Status -->
            <Label Grid.Row="3" Grid.Column="2" 
                   Content="Status:" 
                   VerticalAlignment="Center" 
                   FontWeight="Bold" 
                   Margin="20,5,0,5"/>
            <ComboBox x:Name="cmbStatus" 
                      Grid.Row="3" Grid.Column="3" 
                      Height="30" 
                      Margin="10,5" 
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="In Stock" IsSelected="True"/>
                <ComboBoxItem Content="Out of Stock"/>
                <ComboBoxItem Content="Low Stock"/>
            </ComboBox>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Grid.ColumnSpan="4" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Center" 
                       Margin="0,30,0,0">
                <Button x:Name="btnSave" 
                       Content="Save Product" 
                       Width="120" 
                       Height="35" 
                       Background="#FF065668" 
                       Foreground="White" 
                       BorderBrush="#FF065668" 
                       FontWeight="Bold" 
                       Margin="0,0,10,0" 
                       Click="SaveProduct_Click"/>
                <Button x:Name="btnCancel" 
                       Content="Cancel" 
                       Width="80" 
                       Height="35" 
                       Background="#FFDC3545" 
                       Foreground="White" 
                       BorderBrush="#FFDC3545" 
                       FontWeight="Bold" 
                       Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>