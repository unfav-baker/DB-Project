<Page x:Class="Adminn.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Home"
      Background="#F8F8F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Welcome Section -->
        <StackPanel Grid.Row="0" Margin="30">
            <TextBlock Text="Welcome to PRIME-TECH" 
                     FontSize="28" 
                     FontWeight="Bold"
                     Foreground="#FF065668"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Your Export Management Dashboard"
                     FontSize="18"
                     Foreground="#666666"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Dashboard Cards -->
        <UniformGrid Grid.Row="1" 
                   Columns="3" 
                   Rows="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="30">

            <!-- View Products Card -->
            <Button >
                <StackPanel>
                    <TextBlock Text="📦" 
                             FontSize="40"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,10"/>
                    <TextBlock Text="VIEW PRODUCTS"
                             FontSize="16"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Manage Orders Card -->
            <Button >
                <StackPanel>
                    <TextBlock Text="📑" 
                             FontSize="40"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,10"/>
                    <TextBlock Text="MANAGE ORDERS"
                             FontSize="16"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Generate Reports Card -->
            <Button >
                <StackPanel>
                    <TextBlock Text="📊" 
                             FontSize="40"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,10"/>
                    <TextBlock Text="GENERATE REPORTS"
                             FontSize="16"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Footer -->
        <Border Grid.Row="2" 
              Background="#FF065668"
              Padding="20">
            <TextBlock Text="2025 PRIME-TECH Export Solutions"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>