<Page x:Class="Adminn.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Background="LightGray" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
        <Grid.Resources>
            <!-- Improved Button Style -->
            <Style TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="5" 
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Margin="4"
                                                  SnapsToDevicePixels="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.3" Color="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- Top Header -->
        <Border Background="#FF065668" Height="96" VerticalAlignment="Top">
            <TextBlock TextWrapping="Wrap" Text=" 📊 DashBoard" Margin="30,0,0,37" 
                       Foreground="White" FontWeight="Bold" FontSize="18" 
                       HorizontalAlignment="Left" Width="188" Height="32" VerticalAlignment="Bottom"
                       TextOptions.TextFormattingMode="Display"
                       TextOptions.TextRenderingMode="ClearType"/>
        </Border>

        <!-- Main Content -->
        <Grid Margin="10,96,0,0" UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1.5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="263*"/>
                <ColumnDefinition Width="117*"/>
                <ColumnDefinition Width="380*"/>
            </Grid.ColumnDefinitions>

            <!-- Top Boxes -->
            <Border Grid.Row="0" Grid.Column="0" Margin="10,-32,58,33" 
                    Background="White" Grid.ColumnSpan="2" 
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                </Border.Effect>
                <TextBlock TextWrapping="Wrap" Text="Revenue" Margin="10,0,0,0" 
                           FontWeight="Bold" FontSize="18" 
                           TextOptions.TextFormattingMode="Display"/>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Margin="0,-32,146,33" 
                    Background="White" CornerRadius="10"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                </Border.Effect>
                <TextBlock TextWrapping="Wrap" Text="Total Sales" Margin="10,0,0,0" 
                           FontWeight="Bold" FontSize="18" 
                           TextOptions.TextFormattingMode="Display"/>
            </Border>

            <!-- Middle Boxes -->
            <Border Grid.Column="0" Margin="10,0,58,27" Background="White" Grid.Row="1" 
                    Grid.ColumnSpan="2" CornerRadius="10"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                </Border.Effect>
                <TextBlock TextWrapping="Wrap" Text="Download your earning report" 
                           FontWeight="Bold" FontSize="18" 
                           TextOptions.TextFormattingMode="Display"
                           Margin="10,0,0,0"/>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Margin="0,0,146,10" Background="White" 
                    Grid.RowSpan="2" CornerRadius="10"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                </Border.Effect>
                <TextBlock TextWrapping="Wrap" Text="Total Orders" Margin="10,0,0,0" 
                           FontWeight="Bold" FontSize="18" 
                           TextOptions.TextFormattingMode="Display"/>
            </Border>

            <!-- Bottom Boxes -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,99,0,0" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="10,0,55,10" Background="White" Height="65" 
                        VerticalAlignment="Bottom" CornerRadius="10"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                    </Border.Effect>
                    <TextBlock TextWrapping="Wrap" Text="Summary" Margin="10,0,0,0" 
                               FontWeight="Bold" FontSize="14" 
                               TextOptions.TextFormattingMode="Display"/>
                </Border>

                <Border Margin="0,0,60,10" Background="White" Grid.Column="1" Height="65" 
                        VerticalAlignment="Bottom" CornerRadius="10"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                    </Border.Effect>
                    <TextBlock TextWrapping="Wrap" Text="Daily Sales" Margin="10,0,0,0" 
                               FontWeight="Bold" FontSize="14" 
                               TextOptions.TextFormattingMode="Display"/>
                </Border>
            </Grid>

            <!-- Buttons -->
            <Button Grid.Column="2" Content="Create Report" 
                    HorizontalAlignment="Right" Margin="0,14,29,0" 
                    VerticalAlignment="Top" Height="30" Width="90" 
                    Background="#FF065668" Foreground="White" 
                    BorderBrush="#FF065668"/>

            <Button Grid.Column="2" Content="Add New User" 
                    HorizontalAlignment="Right" Margin="0,0,29,0" 
                    Grid.Row="2" VerticalAlignment="Center" 
                    Height="30" Width="90" Foreground="White" 
                    Background="#FF3EE212" BorderBrush="#FF3EE212"/>

            <Button Grid.Column="2" Content="Export Data" 
                    HorizontalAlignment="Right" Margin="0,157,29,0" 
                    VerticalAlignment="Top" Height="30" Width="90" 
                    Background="White" BorderBrush="White" 
                    Foreground="#FF065668" Grid.RowSpan="2"/>
        </Grid>
    </Grid>
</Page>