<Window x:Class="Dashboard.EmailVerificationApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dashboard"
        mc:Ignorable="d"
        Title="EmailVerificationApp" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Enter Email:"/>
            <TextBox x:Name="EmailBox" Margin="0,5"/>

            <Button Content="Send Code" Click="SendCode_Click" Margin="0,10"/>

            <TextBlock Text="Enter Code:"/>
            <TextBox x:Name="CodeBox" Margin="0,5"/>

            <Button Content="Verify Code" Click="VerifyCode_Click"/>
            <TextBlock x:Name="ResultText" Foreground="Green" FontWeight="Bold" Margin="0,10" Height="141"/>
        </StackPanel>
    </Grid>
</Window>
