<Page x:Class="Adminn.EditProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d"
      d:DesignHeight="680" d:DesignWidth="800"
      Title="Edit Profile">
    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="EditLabelStyle">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style TargetType="TextBox" x:Key="EditTextBoxStyle">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="250"/>
        </Style>
        <Style TargetType="DatePicker" x:Key="EditDatePickerStyle">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="250"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="EditComboBoxStyle">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="250"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButtonStyle" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Edit Profile Information" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Grid.Row="0"/>

            <Grid Grid.Row="1" MaxWidth="600" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name:" Style="{StaticResource EditLabelStyle}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="FullNameEditTextBox" Style="{StaticResource EditTextBoxStyle}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Display Name:" Style="{StaticResource EditLabelStyle}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DisplayNameEditTextBox" Style="{StaticResource EditTextBoxStyle}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Date of Birth:" Style="{StaticResource EditLabelStyle}"/>
                <DatePicker Grid.Row="2" Grid.Column="1" x:Name="DobEditDatePicker" Style="{StaticResource EditDatePickerStyle}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Gender:" Style="{StaticResource EditLabelStyle}"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="GenderEditComboBox" Style="{StaticResource EditComboBoxStyle}">
                    <ComboBoxItem Content="Male"/>
                    <ComboBoxItem Content="Female"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Nationality:" Style="{StaticResource EditLabelStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="NationalityEditTextBox" Style="{StaticResource EditTextBoxStyle}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Address:" Style="{StaticResource EditLabelStyle}"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="AddressEditTextBox" Style="{StaticResource EditTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Phone Number:" Style="{StaticResource EditLabelStyle}"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="PhoneNumberEditTextBox" Style="{StaticResource EditTextBoxStyle}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Email:" Style="{StaticResource EditLabelStyle}"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="EmailEditTextBox" Style="{StaticResource EditTextBoxStyle}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Language Preference:" Style="{StaticResource EditLabelStyle}"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="LanguagePreferenceEditTextBox" Style="{StaticResource EditTextBoxStyle}"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Time Zone:" Style="{StaticResource EditLabelStyle}"/>
                <TextBox Grid.Row="9" Grid.Column="1" x:Name="TimeZoneEditTextBox" Style="{StaticResource EditTextBoxStyle}"/>

            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,10">
                <Button Content="Save Changes" x:Name="SaveChangesButton" Style="{StaticResource PrimaryButtonStyle}" Click="SaveChangesButton_Click" Height="27" Width="123"/>
                <Button Content="Cancel" x:Name="CancelButton" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>