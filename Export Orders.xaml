<Page
    x:Class="Supplier.Export_Orders"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Supplier"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Order Summaries"
    d:DesignHeight="450"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
    </Page.Resources>

    <Grid Background="#FFF0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="61" />
            <RowDefinition Height="*" />
            <RowDefinition Height="55" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF065668">
            <TextBlock
                Margin="20,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="22"
                FontWeight="Bold"
                Foreground="White"
                Text=" 📝 Order Summaries" />
        </Border>

        <DataGrid
            x:Name="ReportsDataGrid"
            Grid.Row="1"
            Margin="10"
            AlternatingRowBackground="#FFF9F9F9"
            AutoGenerateColumns="False"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            CanUserAddRows="False"
            CanUserReorderColumns="True"
            CanUserResizeColumns="True"
            CanUserSortColumns="True"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="#FFE0E0E0"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            ItemsSource="{Binding ReportsList}"
            RowBackground="White"
            SelectionMode="Single"
            VerticalGridLinesBrush="#FFE0E0E0"
            VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>


                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="70"
                    Binding="{Binding OrderId}"
                    Header="Order ID" />
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="90"
                    Binding="{Binding OrderDate, StringFormat='dd/MM/yyyy'}"
                    Header="Date" />
                <DataGridTextColumn
                    Width="2*"
                    MinWidth="150"
                    Binding="{Binding PartyName}"
                    Header="Party Name" />
                <DataGridTextColumn
                    Width="1.2*"
                    MinWidth="120"
                    Binding="{Binding ExportThrough}"
                    Header="Export Through" />
                <DataGridTextColumn
                    Width="1.2*"
                    MinWidth="100"
                    Binding="{Binding Plant}"
                    Header="Plant" />
                <DataGridTextColumn
                    Width="1.2*"
                    MinWidth="120"
                    Binding="{Binding Importer}"
                    Header="Importer" />
                <DataGridTextColumn
                    Width="*"
                    MinWidth="110"
                    Binding="{Binding PhytoNumber}"
                    Header="Phyto Number" />

                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="60"
                    Binding="{Binding Carton}"
                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                    Header="Carton" />
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="70"
                    Binding="{Binding Weight, StringFormat={}{0:N2}}"
                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                    Header="Weight" />
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="80"
                    Binding="{Binding Rate, StringFormat=C}"
                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                    Header="Rate" />
                <DataGridTextColumn
                    Width="*"
                    MinWidth="90"
                    Binding="{Binding TotalAmount, StringFormat=C}"
                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                    Header="Amount" />
                <DataGridTextColumn
                    Width="*"
                    MinWidth="90"
                    Binding="{Binding AmountReceived, StringFormat=C}"
                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                    Header="Received" />
                <DataGridTextColumn
                    Width="*"
                    MinWidth="90"
                    Binding="{Binding Balance, StringFormat=C}"
                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                    Header="Balance" />
            </DataGrid.Columns>
        </DataGrid>

        <Border
            Grid.Row="2"
            Padding="10"
            Background="#F5F5F5"
            BorderBrush="#DDDDDD"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal" />
            </Grid>
        </Border>
    </Grid>
</Page>
