<Page x:Class="Adminn.Export_Orders"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Export_Orders">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="61"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF065668">
            <TextBlock Text="📤 Orders"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="24,0,0,0"
                       Foreground="White"
                       FontSize="22" FontWeight="Bold"/>
        </Grid>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="OrdersDataGrid"
                      Grid.Row="0"
                      Margin="0,0,0,10"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="False" SelectionMode="Single"
                      BorderBrush="#CCCCCC"
                      BorderThickness="1"
                      ItemsSource="{Binding Orders}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="40" Header="" Binding="{Binding IsSelected}" CanUserResize="False"/>

                    <DataGridTextColumn Header="Order ID"         Binding="{Binding OrderId}"         Width="100" MinWidth="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Customer Name"    Binding="{Binding CustomerName}"    Width="2*"  MinWidth="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Product ID"       Binding="{Binding ProductId}"       Width="100" MinWidth="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Quantity Ordered" Binding="{Binding QuantityOrdered}" Width="120" MinWidth="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Date"       Binding="{Binding OrderDate, StringFormat=dd/MM/yyyy}" Width="110" MinWidth="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Delivery Date"    Binding="{Binding DeliveryDate, StringFormat=dd/MM/yyyy}" Width="110" MinWidth="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Order Status"     Binding="{Binding OrderStatus}"     Width="1*"  MinWidth="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Total Price"      Binding="{Binding TotalPrice, StringFormat=C}" Width="100" MinWidth="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Payment Status"   Binding="{Binding PaymentStatus}"   Width="1.2*" MinWidth="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Supplier ID"      Binding="{Binding SupplierId}"      Width="100" MinWidth="80" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1"
                    Height="45"
                    Background="#F5F5F5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Content="Refresh Orders"
                                Background="#FF065668"
                                BorderBrush="#FF065668"
                                Width="auto" Padding="10,5"
                                Foreground="White"
                                Height="30"
                                Click="ViewOrdersButton_Click" 
                                Margin="0,0,10,0"/>
                        <Button Content="👁" ToolTip="View Selected Order"
                                Background="#6C757D"
                                BorderBrush="#6C757D"
                                Width="35"
                                Foreground="White"
                                Height="30"
                                Margin="0,0,5,0"
                                FontSize="14"
                                Click="ViewSelectedOrder_Click"/>
                        <Button Content="🗑" ToolTip="Delete Order"
                                Background="#FFDC3545"
                                BorderBrush="#FFDC3545"
                                Width="35"
                                Foreground="White"
                                Height="30"
                                Margin="0,0,10,0"
                                FontSize="14"
                                Click="DeleteOrder_Click"/>
                        <Button Content="📊 Report" ToolTip="Create Order Report"
                                Background="#FF28A745"
                                BorderBrush="#FF28A745"
                                Width="auto" Padding="10,5"
                                Foreground="White"
                                Height="30"
                                Margin="0,0,0,0"
                                FontSize="12"
                                Click="CreateOrderReport_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>