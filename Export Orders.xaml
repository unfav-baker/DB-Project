<Page
    x:Class="Adminn.Export_Orders"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Adminn"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Reports"
    d:DesignHeight="390"
    d:DesignWidth="623"
    mc:Ignorable="d">



    <Grid>
        <!--  DataGrid  -->
        <DataGrid
            Margin="0,61,0,45"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            SelectionMode="Single" BorderBrush="Black">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Width="100"/>
                <DataGridTextColumn Header="Phyto Number" Width="120"/>
                <DataGridTextColumn Header="Party Name" Width="150"/>
                <DataGridTextColumn Header="Export Through" Width="120"/>
                <DataGridTextColumn Header="Plant" Width="120"/>
                <DataGridTextColumn Header="Importer" Width="120"/>
                <DataGridTextColumn Header="Carton" Width="80"/>
                <DataGridTextColumn Header="Weight" Width="80"/>
                <DataGridTextColumn Header="Rate" Width="80"/>
                <DataGridTextColumn Header="Amount" Width="100"/>
                <DataGridTextColumn Header="Received" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Height="45" VerticalAlignment="Bottom" Background="White">
            <Button Content="View Order Status" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.718,-0.081" Background="#FF065668" BorderBrush="#FF065668" Width="118" Foreground="White" Height="27"/>

            <Button Content="Update Order Status" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.718,-0.081" Background="#FF065668" BorderBrush="#FF065668" Width="118" Foreground="White" Height="27" Margin="0,0,100,0"/>

            <Button Content="Export Data" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.718,-0.081" Background="#FF065668" BorderBrush="#FF065668" Width="118" Foreground="White" Height="26" Margin="107,0,0,0"/>

        </Grid>
        <Grid Background="#FF065668" Height="61" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,13,0,0" TextWrapping="Wrap" Text=" 📤 Export Orders" VerticalAlignment="Top" Width="200" Foreground="White" Background="#FF065668"  FontSize="22" FontWeight="Bold"/>
    </Grid>




</Page>

