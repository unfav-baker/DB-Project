<Page
    x:Class="Employee.Generate_Reports"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Employee"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Reports"
    d:DesignHeight="390"
    d:DesignWidth="623"
    mc:Ignorable="d">



    <Grid>
        <!--  DataGrid  -->
        <DataGrid
            Margin="0,61,0,45"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            SelectionMode="Single" BorderBrush="Black">
            <DataGrid.Columns>
                <DataGridTextColumn Width="100" Header="Date" />
                <DataGridTextColumn Width="120" Header="Phyto Number" />
                <DataGridTextColumn Width="150" Header="Party Name" />
                <DataGridTextColumn Width="120" Header="Export Through" />
                <DataGridTextColumn Width="120" Header="Plant" />
                <DataGridTextColumn Width="120" Header="Importer" />
                <DataGridTextColumn Width="120" Header="Carton" />
                <DataGridTextColumn Width="120" Header="Weight" />
                <DataGridTextColumn Width="120" Header="Rate" />
                <DataGridTextColumn Width="120" Header="Amount" />
                <DataGridTextColumn Width="120" Header="Recieved" />
                <DataGridTextColumn Width="120" Header="Balance" />

            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.ColumnSpan="2" Height="45" VerticalAlignment="Bottom" Background="White">
            <Button Content="Create New Report" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.718,-0.081" Background="#FF065668" BorderBrush="#FF065668" Width="118" Foreground="White" Height="27"/>
        </Grid>
        <Grid Background="#FF065668" Height="61" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text=" 📤 Generate Reports" VerticalAlignment="Top" Width="243" Foreground="White" Background="#FF065668"  FontSize="22" FontWeight="Bold"/>
    </Grid>




</Page>
