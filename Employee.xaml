<Page x:Class="Adminn.Employee"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Employee">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="61"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF065668">
            <TextBlock Text="👨‍💼 Employee"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="24,0,0,0"
                       Foreground="White"
                       FontSize="22" FontWeight="Bold"/>
        </Grid>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="EmployeeDataGrid"
                      Grid.Row="0"
                      Margin="0,0,0,10"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="False" SelectionMode="Single"
                      BorderBrush="#CCCCCC"
                      BorderThickness="1"
                      ItemsSource="{Binding Employees}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="40" Header="" Binding="{Binding IsSelected}" CanUserResize="False"/>
                    <DataGridTextColumn Header="Employee ID"   Binding="{Binding EmployeeId}"      Width="100" MinWidth="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Name"          Binding="{Binding Name}"            Width="1.5*" MinWidth="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Role"          Binding="{Binding Role}"            Width="1.5*" MinWidth="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Phone Number"  Binding="{Binding PhoneNumber}"     Width="120" MinWidth="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Salary"        Binding="{Binding Salary, StringFormat=C}" Width="100" MinWidth="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status"        Binding="{Binding Status}"          Width="90"  MinWidth="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Created At"    Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="110" MinWidth="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Updated At"    Binding="{Binding UpdatedAt, StringFormat=dd/MM/yyyy}" Width="110" MinWidth="100" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1"
                    Height="45"
                    Background="#F5F5F5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Content="Add New Employee" Background="#FF065668" BorderBrush="#FF065668" Width="auto" Padding="10,5" Foreground="White" Height="30" Click="AddEmployee_Click" Margin="0,0,10,0"/>
                        <Button Content="👁" ToolTip="View Employee" Background="#6C757D" BorderBrush="#6C757D" Width="35" Foreground="White" Height="30" Margin="0,0,5,0" FontSize="14" Click="ViewEmployee_Click"/>
                        <Button Content="🗑" ToolTip="Delete Employee" Background="#FFDC3545" BorderBrush="#FFDC3545" Width="35" Foreground="White" Height="30" Margin="0,0,0,0" FontSize="14" Click="DeleteEmployee_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>