<Page x:Class="Supplier.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SupplierProfilePage"
      Background="#F3F4F6">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="#FF065668" Grid.Column="0" >
            <Image x:Name="SupplierImage" Source="Images/dsd.png" Height="100" Width="100" Margin="0,20" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SidebarSupplierName" Text="Supplier Name" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />
            <TextBlock x:Name="SidebarSupplierEmail" Text="Supplier Email" Foreground="LightGray" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,30"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" Padding="20">
            <StackPanel Orientation="Vertical" >

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Supplier Profile" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                    <Button x:Name="EditProfileButton" Content="Edit Profile" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="10,5" Background="#FF065668" Foreground="White" Click="EditProfileButton_Click" Margin="10,0,0,0" Width="82"/>
                </Grid>


                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Full Name" FontWeight="Bold"/>
                            <TextBlock x:Name="FullNameTextBlock" Text="example"/>
                            <TextBlock Text="Gender" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="GenderTextBlock" Text="example"/>
                            <TextBlock Text="Date of Birth" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="DobTextBlock" Text="example"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Nationality" FontWeight="Bold"/>
                            <TextBlock x:Name="NationalityTextBlock" Text="example"/>
                            <TextBlock Text="Email" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="EmailTextBlock" Text="example.com"/>
                            <TextBlock Text="Phone Number" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="PhoneNumberTextBlock" Text="example"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Supplier ID" FontWeight="Bold"/>
                            <TextBlock x:Name="SupplierIdTextBlock" Text="example"/>
                            <TextBlock Text="Last Login" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="LastLoginTextBlock" Text="example"/>
                            <TextBlock Text="Registration Date" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="RegistrationDateTextBlock" Text="example"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Role/Type" FontWeight="Bold"/>
                            <TextBlock x:Name="RoleTextBlock" Text="example"/>
                            <TextBlock Text="Account Status" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="AccountStatusTextBlock" Text="example"/>
                            <TextBlock Text="Verification Status" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="VerificationStatusTextBlock" Text="example"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Language Preference" FontWeight="Bold"/>
                        <TextBlock x:Name="LanguagePreferenceTextBlock" Text="example"/>
                        <TextBlock Text="Time Zone" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TimeZoneTextBlock" Text="example"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>