<Page x:Class="Employee.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Employee"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Employee Profile"
      Background="#F3F4F6">

    <Page.Resources>
        <Style x:Key="ProfileLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ProfileValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF065668" CornerRadius="10,0,0,10">
            <StackPanel>
                <Ellipse Height="100" Width="100" Margin="0,30,0,10">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="Images/dsd.png" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock x:Name="SidebarEmployeeName" Text="{Binding FullName, FallbackValue='Employee Name'}" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                <TextBlock x:Name="SidebarEmployeeEmail" Text="{Binding Email, FallbackValue='employee@example.com'}" Foreground="LightGray" FontSize="14" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,5,10,30"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="25,10,25,20">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Employee Profile" FontSize="26" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" Color="#FFDADADA" Opacity="0.5" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Personal Information" FontSize="18" FontWeight="SemiBold" Foreground="#FF065668" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Full Name" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding FullName, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>

                                <TextBlock Text="Gender" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding Gender, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>

                                <TextBlock Text="Date of Birth" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding DateOfBirth, StringFormat='dd MMMM yyyy', FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>

                                <TextBlock Text="Address" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding Address, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nationality" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding Nationality, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>

                                <TextBlock Text="Email" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding Email, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="Phone Number" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding PhoneNumber, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" Color="#FFDADADA" Opacity="0.5" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Employment Details" FontSize="18" FontWeight="SemiBold" Foreground="#FF065668" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Employee ID" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding EmployeeId, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>

                                <TextBlock Text="Hire Date" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding HireDate, StringFormat='dd MMMM yyyy', FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>

                                <TextBlock Text="Role / Position" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding Role, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding Status, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>

                                <TextBlock Text="Last Login" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding LastLogin, StringFormat='dd MMM yyyy, hh:mm tt', FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>

                                <TextBlock Text="Managing Admin" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding ManagingAdminName, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" Color="#FFDADADA" Opacity="0.5" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Preferences &amp; Settings" FontSize="18" FontWeight="SemiBold" Foreground="#FF065668" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Language Preference" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding LanguagePreference, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>

                                <TextBlock Text="Time Zone" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding TimeZone, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Login Notifications" Style="{StaticResource ProfileLabelStyle}"/>
                                <TextBlock Text="{Binding LoginNotificationsEnabled, FallbackValue='N/A'}" Style="{StaticResource ProfileValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button x:Name="EditProfileButton" Content="Edit Profile" Click="EditProfileButton_Click" 
                        HorizontalAlignment="Left" Width="150" Height="40" Margin="0,10,0,0"
                        Background="#FF065668" Foreground="White" FontWeight="SemiBold" FontSize="14">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
