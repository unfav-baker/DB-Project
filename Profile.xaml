<Page x:Class="Adminn.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Adminn"
      mc:Ignorable="d"
      d:DesignHeight="780" d:DesignWidth="1000"
      Title="Profile">
    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="HeaderTextStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#505050"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style TargetType="Border" x:Key="SectionBorderStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#B0BEC5"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#F8F8F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                    <Ellipse Width="162" Height="100" Margin="0,0,0,10">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="Images/dsd.png"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Muhammad Fayaz" FontSize="22" FontWeight="SemiBold" x:Name="ProfileNameTextBlock"/>
                        <TextBlock Text=" ✓" Foreground="#1E88E5" FontWeight="Bold" FontSize="16"/>
                    </StackPanel>
                    <TextBlock Text="Fayyaz@Primefoods.com.pk" FontSize="14" Foreground="#505050" HorizontalAlignment="Center" Margin="0,5,0,0" x:Name="ProfileEmailHeaderTextBlock"/>
                </StackPanel>

                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,0,25">
                    <Button Content="Edit Profile" Style="{StaticResource PrimaryButtonStyle}"
                            x:Name="EditProfileButton" Click="EditProfileButton_Click" Height="30" Width="110"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Personal details" Style="{StaticResource HeaderTextStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Full name:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Muhammad Fayyaz" Style="{StaticResource ValueStyle}" x:Name="FullNameTextBlock"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Date of Birth:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="January 1, 1987" Style="{StaticResource ValueStyle}" x:Name="DobTextBlock"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gender:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Male" Style="{StaticResource ValueStyle}" x:Name="GenderTextBlock"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Nationality:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Pakistani" Style="{StaticResource ValueStyle}" x:Name="NationalityTextBlock"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Address:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="S-4 AB Heights, Airport Road, Lhr" Style="{StaticResource ValueStyle}" x:Name="AddressTextBlock" TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Phone Number:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="0301-8515333" Style="{StaticResource ValueStyle}" x:Name="PhoneNumberTextBlock"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Account Details" Style="{StaticResource HeaderTextStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Display Name:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Muhammad Fayyaz" Style="{StaticResource ValueStyle}" x:Name="DisplayNameTextBlock"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Account Created:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="March 20, 2020" Style="{StaticResource ValueStyle}" x:Name="AccountCreatedTextBlock"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Fayyaz@Primefoods.com.pk" Style="{StaticResource ValueStyle}" x:Name="EmailTextBlock"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Account Verification:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Verified" Style="{StaticResource ValueStyle}" FontWeight="SemiBold" Foreground="#2E7D32" x:Name="AccountVerificationTextBlock"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Language Preference:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="English" Style="{StaticResource ValueStyle}" x:Name="LanguagePreferenceTextBlock"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Time Zone:" Style="{StaticResource LabelStyle}" Margin="0,8,10,8"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="(UTC + 5)" Style="{StaticResource ValueStyle}" x:Name="TimeZoneTextBlock"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>